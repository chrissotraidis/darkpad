<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Perfect Dark — visionOS (Phase 5, flat 2D).

  Same app, same bundle id, same sources (GoldenEye D-024); only a handful of
  Info.plist keys are platform-specific, and they are kept in a SECOND file
  rather than conditionalised into ios/Info.plist so the shipping iOS target is
  untouched by Phase 5.

  What differs from ios/Info.plist, and why:

   - UIApplicationSceneManifest, with UIApplicationSupportsMultipleScenes
     INSIDE the manifest dict. Outside it the key is silently ignored and the
     app gets a single-scene lifecycle it did not ask for (charter Phase 5).
   - CFBundleIconName: visionOS icons are a layered .solidimagestack in an
     asset catalog (app/ios/Assets-visionos.xcassets, generated by
     scripts/gen-icons.py). actool owns CFBundleIcons there, but the NAME
     still has to be declared here. The iOS target's legacy CFBundleIconFiles
     PNG list is gone: a flat PNG renders as a blank tile on visionOS.
   - No LSRequiresIPhoneOS, no UISupportedInterfaceOrientations: a visionOS
     window is user-resizable and has no orientation.
   - No UIStatusBarHidden / UIViewControllerBasedStatusBarAppearance: there is
     no status bar, and SDL's calls to those APIs are compiled out by
     overlay/sdl2/visionos-compat.patch.
   - No CADisableMinimumFrameDurationOnPhone: an iPhone ProMotion gate that
     means nothing here.
   - No UIRequiredDeviceCapabilities: arm64 + metal are the only thing xrOS
     has ever run on.

  Unchanged and load-bearing: UIFileSharingEnabled +
  LSSupportsOpeningDocumentsInPlace (the ROM, xbla/ and pd.ini live in
  Documents exactly as on iOS — that is the onboarding surface in Files on
  Vision Pro too), UIApplicationSupportsIndirectInputEvents, and the
  perfectdark:// URL scheme.
-->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Perfect Dark</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Perfect Dark</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<!-- The manifest, with NO UISceneConfigurations (round V, D-047).
	     SwiftUI declares this app's scenes now - PDVisionApp.swift is the
	     @main, because an ImmersiveSpace can only be declared by a SwiftUI App
	     - and a UISceneConfigurations entry here would fight it for the window
	     scene. Phase 5 needed a configuration with a delegate because the
	     lifecycle-adoption check is not satisfied by an empty manifest
	     (D-038/D-037 §4); a SwiftUI app satisfies it by construction.

	     PDSceneDelegate is compiled OUT of this target, and that is
	     load-bearing rather than tidy: UIKit persists a scene session's
	     configuration name AND delegate class name across installs of the same
	     bundle id, so a headset that has run the Phase-5 builds restores a
	     session naming PDSceneDelegate. With the class absent the lookup fails
	     and UIKit falls back to the app delegate's configuration, which is
	     SwiftUI's (q2repro NOTES-FROM-VKQUAKE; a fresh simulator never
	     reproduces it).

	     SupportsMultipleScenes stays true and stays INSIDE the manifest dict,
	     where the charter's Phase 5 trap puts it - outside it the key is
	     silently ignored. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<!-- Insurance, not a feature: nothing in this app scans for Bluetooth.
	     SDL's iOS HIDAPI backend opens a CBCentralManager when the Steam
	     HIDAPI hint is on (upstream input.c sets it), and iOS TERMINATES an app
	     that touches CoreBluetooth without this key - the 0.0.0.2/0.0.0.3 device
	     crash. pd_ios_main.m now overrides that hint off; if anything ever
	     reaches CoreBluetooth anyway it must prompt, never abort. -->
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Perfect Dark can connect to Bluetooth game controllers.</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>Perfect Dark can connect to Bluetooth game controllers.</string>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.rebelancap.perfectdark</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>perfectdark</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
