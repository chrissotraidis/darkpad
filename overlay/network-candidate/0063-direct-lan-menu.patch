--- a/port/src/netlobbymenu.c
+++ b/port/src/netlobbymenu.c
@@ -1422,6 +1422,68 @@
 	return 0;
 }
 
+// Direct LAN deliberately bypasses account creation and public room services.
+extern s32 netSessionDirectConnect(const char *addr, u16 port);
+static char s_DirectAddress[MPSETUP_MAXNAME + 1] = "127.0.0.1";
+static char s_DirectPort[MPSETUP_MAXNAME + 1] = "27382";
+static char s_DirectMessage[96] = "Enter the host's IPv4 address and port.";
+static struct menudialogdef s_DirectLanDialog;
+
+static char *textDirectAddress(struct menuitem *item) { return s_DirectAddress; }
+static char *textDirectPort(struct menuitem *item) { return s_DirectPort; }
+static char *textDirectMessage(struct menuitem *item) { return s_DirectMessage; }
+
+static MenuItemHandlerResult handlerDirectEdit(s32 op, struct menuitem *item, union handlerdata *data)
+{
+	char *value = item->param ? s_DirectPort : s_DirectAddress;
+	if (op == MENUOP_GETTEXT) snprintf(data->keyboard.string, MPSETUP_MAXNAME + 1, "%s", value);
+	if (op == MENUOP_SETTEXT) snprintf(value, MPSETUP_MAXNAME + 1, "%s", data->keyboard.string);
+	return 0;
+}
+static struct menuitem s_DirectAddressItems[] = {
+	{ MENUITEMTYPE_KEYBOARD, 0, 0, 0, 0, handlerDirectEdit },
+	{ MENUITEMTYPE_END },
+};
+static struct menuitem s_DirectPortItems[] = {
+	{ MENUITEMTYPE_KEYBOARD, 1, 0, 0, 0, handlerDirectEdit },
+	{ MENUITEMTYPE_END },
+};
+static struct menudialogdef s_DirectAddressDialog = { MENUDIALOGTYPE_DEFAULT, (uintptr_t)"Host IPv4 Address", s_DirectAddressItems, NULL, MENUDIALOGFLAG_LITERAL_TEXT, NULL };
+static struct menudialogdef s_DirectPortDialog = { MENUDIALOGTYPE_DEFAULT, (uintptr_t)"Host Port", s_DirectPortItems, NULL, MENUDIALOGFLAG_LITERAL_TEXT, NULL };
+
+static MenuItemHandlerResult handlerDirectJoin(s32 op, struct menuitem *item, union handlerdata *data)
+{
+	if (op == MENUOP_SET) {
+		unsigned a, b, c, d;
+		char extra, *end;
+		long port = strtol(s_DirectPort, &end, 10);
+		if (sscanf(s_DirectAddress, "%u.%u.%u.%u%c", &a, &b, &c, &d, &extra) != 4
+				|| a > 255 || b > 255 || c > 255 || d > 255 || end == s_DirectPort || *end || port < 1 || port > 65535) {
+			snprintf(s_DirectMessage, sizeof(s_DirectMessage), "Enter a valid IPv4 address and port (1-65535).");
+		} else if (netSessionDirectConnect(s_DirectAddress, (u16)port) != 0) {
+			snprintf(s_DirectMessage, sizeof(s_DirectMessage), "Cannot join: a session is active or the socket failed.");
+		} else {
+			snprintf(s_DirectMessage, sizeof(s_DirectMessage), "Connecting to %s:%ld...", s_DirectAddress, port);
+		}
+	}
+	return 0;
+}
+static struct menuitem s_DirectLanItems[] = {
+	{ MENUITEMTYPE_LABEL, 0, 0, (uintptr_t)textDirectMessage, 0, NULL },
+	{ MENUITEMTYPE_SELECTABLE, 0, MENUITEMFLAG_SELECTABLE_OPENSDIALOG, (uintptr_t)textDirectAddress, 0, (void *)&s_DirectAddressDialog },
+	{ MENUITEMTYPE_SELECTABLE, 0, MENUITEMFLAG_SELECTABLE_OPENSDIALOG, (uintptr_t)textDirectPort, 0, (void *)&s_DirectPortDialog },
+	{ MENUITEMTYPE_SELECTABLE, 0, MENUITEMFLAG_LITERAL_TEXT, (uintptr_t)"Join", 0, handlerDirectJoin },
+	{ MENUITEMTYPE_SELECTABLE, 0, MENUITEMFLAG_LITERAL_TEXT | MENUITEMFLAG_SELECTABLE_CLOSESDIALOG, (uintptr_t)"Back", 0, NULL },
+	{ MENUITEMTYPE_END },
+};
+static struct menudialogdef s_DirectLanDialog = { MENUDIALOGTYPE_DEFAULT, (uintptr_t)"Direct LAN", s_DirectLanItems, NULL, MENUDIALOGFLAG_LITERAL_TEXT, NULL };
+
+MenuItemHandlerResult netDirectMenuHandler(s32 op, struct menuitem *item, union handlerdata *data)
+{
+	if (op == MENUOP_SET) menuPushDialog(&s_DirectLanDialog);
+	return 0;
+}
+
