 }
 
+/** Direct sessions share transport setup, but never join a lobby room. */
+s32 netSessionDirectConnect(const char *addr, u16 port)
+{
+	s32 result;
+	if (!addr || !addr[0] || !port) return -1;
+	result = netSessionLobbyConnect(addr, port, "", "Player", NULL, 0);
+	if (result == 0) s_LobbyRoomOn = 0;
+	return result;
+}
