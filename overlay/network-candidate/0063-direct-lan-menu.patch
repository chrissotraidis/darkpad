+
+void netSessionLobbyStop(void)
+{
+	if (s_LobbyRoomOn) netSessionStopMenuSession();
+}
+
+// Menu ownership keeps this from closing command-line or lobby sessions.
+s32 netSessionDirectState(void)
+{
+	if (!s_DirectMenuSession) return 0;
+	if (s_ClientState == NETCS_GONE) return -1;
+	return s_ClientState >= NETCS_JOINED ? 2 : 1;
+}
+
+void netSessionDirectCancel(void)
+{
+	// Loading a stage also closes menus: that is not cancellation.
+	if (!s_DirectMenuSession || s_MatchActive) return;
+	if (s_ClientState != NETCS_GONE) netClientLeave();
+	netSessionStopMenuSession();
 }
 
