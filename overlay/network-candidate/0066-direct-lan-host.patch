+static MenuItemHandlerResult handlerDirectHost(s32 op, struct menuitem *item, union handlerdata *data)
+{
+	if (op == MENUOP_CHECKDISABLED) return netSessionDirectState() != 0;
+	if (op == MENUOP_SET) {
+		char *end;
+		long port = strtol(s_DirectPort, &end, 10);
+		if (end == s_DirectPort || *end || port < 1 || port > 65535) {
+			snprintf(s_DirectMessage, sizeof(s_DirectMessage), "Enter a valid port (1-65535).");
+		} else if (netSessionDirectHost((u16)port) != 0) {
+			snprintf(s_DirectMessage, sizeof(s_DirectMessage), "Cannot host: port is busy or a session is active.");
+		} else {
+			menuPushDialog(&s_DirectHostDialog);
+		}
+	}
+	return 0;
+}
+
+static char *textDirectHostStatus(struct menuitem *item)
+{
+	static char text[96];
+	snprintf(text, sizeof(text), "UDP %u - %d remote players ready\n",
+		netSessionLobbyPort(), netSessionHostNumClients());
+	return text;
+}
+
+static MenuItemHandlerResult handlerDirectStart(s32 op, struct menuitem *item, union handlerdata *data)
+{
+	if (op == MENUOP_CHECKDISABLED)
+		return netSessionDirectState() != 3 || netSessionHostNumClients() == 0;
+	if (op == MENUOP_SET && netSessionDirectState() == 3 && netSessionHostNumClients() > 0) {
+		g_MpSetup.chrslots |= 1;
+		netSessionLobbyStartMatch();
+	}
+	return 0;
+}
+
+static MenuDialogHandlerResult dialogDirectHost(s32 op, struct menudialogdef *dialogdef, union handlerdata *data)
+{
+	if (op == MENUOP_CLOSE) netSessionDirectCancel();
+	return 0;
+}
