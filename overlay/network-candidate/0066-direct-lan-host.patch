Subject: Add menu-driven Direct LAN Combat hosting and setup

--- a/port/src/net/netsession.c
+++ b/port/src/net/netsession.c
@@ -5319,6 +5319,27 @@
 	return result;
 }
 
+/** Open a private LAN host without a lobby account or room ticket. */
+s32 netSessionDirectHost(u16 port)
+{
+	char name[sizeof(s_Name)];
+	s32 oldport = s_Port;
+	s32 result;
+	if (!port || s_Role != NETROLE_NONE) return -1;
+	snprintf(name, sizeof(name), "%s", s_Name[0] ? s_Name : "Player");
+	s_Port = port;
+	result = netSessionLobbyHost(name);
+	s_Port = oldport; // The dialog port does not rewrite the saved Net.Port.
+	if (result == 0) {
+		s_LobbyRoomOn = 0;
+		s_DirectMenuSession = 1;
+		g_NetCoopSetup.on = 0; // This entry explicitly hosts Combat Simulator.
+	} else {
+		netSessionNameBack();
+	}
+	return result;
+}
+
 /**
  * The room is left or gone: the session it made closes (a host says
  * goodbye to its clients, a client to its host). Not mid-match: the lobby
@@ -5369,6 +5390,7 @@
 s32 netSessionDirectState(void)
 {
 	if (!s_DirectMenuSession) return 0;
+	if (s_Role == NETROLE_HOST) return 3;
 	if (s_ClientState == NETCS_GONE) return -1;
 	return s_ClientState >= NETCS_JOINED ? 2 : 1;
 }
