+	/* Network ticks may leave currentplayer on a remote slot. */
+	struct player *p = g_NetMode != NETMODE_NONE
+		? netLocalPlayer(NULL) : g_Vars.currentplayer;
 
 	if (!p || !p->prop) {
 		return 0;
