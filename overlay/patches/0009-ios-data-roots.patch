diff --git a/port/src/system.c b/port/src/system.c
index fffbe04b9..22f137f0f 100644
--- a/port/src/system.c
+++ b/port/src/system.c
@@ -63,8 +63,43 @@ static char logPath[2048];
 static s32 sysArgc;
 static const char **sysArgv;
 
+#ifdef PLATFORM_IOS
+/**
+ * Where the app's Documents and Caches directories are.
+ *
+ * The shell puts them in the environment before it calls pdEngineMain(), which
+ * keeps the engine free of any Foundation dependency and keeps this a plain C
+ * lookup that works identically in the simulator, on device and under a unit
+ * test. The fallbacks are only ever reached if the shell did not run - a
+ * headless harness, say - and are deliberately somewhere writable rather than
+ * somewhere wrong.
+ */
+const char *sysIosDocumentsPath(void)
+{
+	const char *p = getenv("PD_IOS_DOCUMENTS");
+	return (p && *p) ? p : ".";
+}
+
+const char *sysIosCachesPath(void)
+{
+	const char *p = getenv("PD_IOS_CACHES");
+	return (p && *p) ? p : sysIosDocumentsPath();
+}
+#endif
+
 static inline void sysLogSetPath(const char *fname)
 {
+#ifdef PLATFORM_IOS
+	// An iOS app's working directory is "/" and is not writable, so the log has
+	// to start where the user can also read it: Documents, which is the same
+	// place both data roots resolve to (fs.c) and is Files-visible.
+	snprintf(logPath, sizeof(logPath), "%s/%s", sysIosDocumentsPath(), fname);
+	FILE *iosf = fopen(logPath, "wb");
+	if (iosf) {
+		fclose(iosf);
+	}
+	return;
+#endif
 	// figure out where the log is and clear it
 	// try working dir first
 	snprintf(logPath, sizeof(logPath), "./%s", fname);
@@ -381,6 +416,15 @@ s32 sysRestartRequested(void)
 
 void sysGetExecutablePath(char *outPath, const u32 outLen)
 {
+#ifdef PLATFORM_IOS
+	// $E is upstream's "the folder the player already has open" - the one that
+	// gets screenshots, texture-packs/, model-packs/, xbla/ and, when it is
+	// writable, the saves. An app bundle is never writable, so on iOS $E is
+	// Documents: the one directory the player can actually see and drop a ROM
+	// into (UIFileSharingEnabled + LSSupportsOpeningDocumentsInPlace).
+	snprintf(outPath, outLen, "%s", sysIosDocumentsPath());
+	return;
+#endif
 	// try asking SDL
 	char *sdlPath = SDL_GetBasePath();
 
@@ -415,6 +459,12 @@ void sysGetExecutablePath(char *outPath, const u32 outLen)
 
 void sysGetHomePath(char *outPath, const u32 outLen)
 {
+#ifdef PLATFORM_IOS
+	// SDL_GetPrefPath would give ~/Library/Application Support/perfectdark:
+	// real and writable, and invisible in Files. Both roots are Documents.
+	snprintf(outPath, outLen, "%s", sysIosDocumentsPath());
