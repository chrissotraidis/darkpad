+/**
+ * The iOS shell's master volume / mute / other-app duck, as one gain.
+ *
+ * Perfect Dark's own three audio settings live in the eeprom game file and are
+ * the game's (Audio Options). A phone needs one more thing on top of them: a
+ * volume the player can reach without opening the game's menus, a mute, and
+ * the family's "Other App Audio" policy, two of whose five modes attenuate the
+ * GAME rather than the podcast. All three are one multiplier on the frame's
+ * buffer, applied here because this is the last place the port owns the samples
+ * before SDL takes them.
+ *
+ * Weak so that a build without the shell (the macOS oracle never defines
+ * PLATFORM_IOS, but a future host build might) links and returns unity.
+ * app/ios/PDAudio.m has the real one.
+ */
+__attribute__((weak)) float pdPlatformAudioGain(void)
+{
+	return 1.0f;
+}
+
+/**
+ * The queue instrument (M-029, M-035). audioEndFrame() pushes exactly one
+ * frame's worth of samples per RENDERED frame while the device drains in real
+ * time, so a load hitch is a gap in production with nothing banked against it -
+ * which is audible as a stutter and is invisible to every other counter the
+ * port has. Read over the bridge as the audio_* rows.
+ */
+s32 g_PdAudioQueued = 0;
+s32 g_PdAudioQueuedMin = -1;
+s32 g_PdAudioQueuedMax = 0;
+s32 g_PdAudioUnderruns = 0;
+s32 g_PdAudioDrops = 0;
+s32 g_PdAudioPushes = 0;
+s32 g_PdAudioReprimes = 0;
+/** Samples of silence inserted, so the cost of the cushion can be read. */
+s32 g_PdAudioSilence = 0;
+/** Samples handed to SDL by the last push: 22020/fps if the clock is right. */
+s32 g_PdAudioPushSamples = 0;
+/** What SDL actually opened, which is not necessarily what was asked for. */
+s32 g_PdAudioHaveFreq = 0;
+s32 g_PdAudioHaveSamples = 0;
+s32 g_PdAudioHaveChannels = 0;
+s32 g_PdAudioHaveFormat = 0;
+s32 g_PdAudioBufferSize = 0;
+s32 g_PdAudioQueueLimit = 0;
+s32 g_PdAudioPrimeSamples = 0;
+/** Samples the last push actually handed over after rate matching (D-039). */
+s32 g_PdAudioOutSamples = 0;
+/** The converged output/input ratio x 10000, so 10350 is +3.5%. */
+s32 g_PdAudioRateMilli = 10000;
+
+/**
+ * The per-push trace (D-078): one row per audioEndFrame() push, in a ring the
+ * bridge's `audio trace` dumps to a file. Off until asked for; when on it costs
+ * one counter read and five stores a push. The stall measurements in
+ * MEASUREMENTS.md are this table.
+ */
+struct pdaudiotrace {
+	u64 us;          /* SDL performance counter, in microseconds */
+	s32 queued;      /* queue level before this push, samples */
+	s32 outSamples;  /* samples handed over by this push (0: dropped) */
+	s32 rateMilli;   /* the resample ratio after this push's update, x 10000 */
+	s32 integ;       /* the integrator x 1e6 */
+	s32 flags;       /* 1 underrun, 2 dropped, 4 resync re-prime, 8 resync drop-in, 16 fade in, 32 fade out */
+};
+#define PD_AUDIO_TRACE_LEN 16384
+struct pdaudiotrace g_PdAudioTrace[PD_AUDIO_TRACE_LEN];
+u32 g_PdAudioTraceCount = 0;
+s32 g_PdAudioTraceOn = 0;
+
+static void audioIosTrace(s32 queued, s32 out, float integ, s32 flags)
+{
+	struct pdaudiotrace *t;
+	if (!g_PdAudioTraceOn) {
+		return;
+	}
+	t = &g_PdAudioTrace[g_PdAudioTraceCount % PD_AUDIO_TRACE_LEN];
+	t->us = (u64)((double)SDL_GetPerformanceCounter() * 1000000.0 / (double)SDL_GetPerformanceFrequency());
+	t->queued = queued;
+	t->outSamples = out;
+	t->rateMilli = g_PdAudioRateMilli;
+	t->integ = (s32)lrintf(integ * 1000000.0f);
+	t->flags = flags;
+	g_PdAudioTraceCount++;
+}
+
+static s16 *gainBuf = NULL;
+static u32 gainBufSize = 0;
+
+/**
+ * Audio.PrimeSamples - the cushion of silence queued ONCE, in front of the
+ * first frame's audio, and never again.
+ *
+ * The queue is a sawtooth: production is one rendered frame's samples per frame
+ * (368 at 22020 Hz and 60 fps), consumption is the device pulling a whole
+ * Audio.BufferSize buffer (1024) at a time. Its floor is wherever it started,
+ * so it has to start above zero or the callback is regularly handed a short
+ * read and pads the rest with silence - the click.
+ *
+ * 1536 = one and a half device buffers, which is also the rate-matcher's
+ * setpoint below: the loop's job is to hold the queue there, so starting there
+ * means it has nothing to correct.
+ */
+static s32 primeSamples = 1536;
+
+/**
+ * Audio.RateMatch - resample the frame's audio to the rate the DEVICE actually
+ * consumes at, instead of the rate the engine thinks it produces at (D-039).
+ *
+ * Measured on the user's iPhone Air over 8.1 minutes (M-036): the engine pushes
+ * 368 samples 60.0 times a second = 22,080 samples/s, and the device consumes
+ * 22,851 samples/s - **3.5 % faster**, steadily, for ever. Any fixed cushion is
+ * therefore eaten at a fixed rate (a 2048-sample one lasts 2.65 s, measured),
+ * and every mitigation that re-queues silence just makes the gaps longer
+ * instead of more frequent. The user could still hear it.
+ *
+ * The engine cannot be asked to produce at a different rate: the N64 audio
+ * manager is hard-wired to 22020 (audiomgr.c:64, osAiSetFrequency(22020)), and
+ * asking SDL for the device's native rate would only mean the app must supply
+ * it. So the port resamples, by the small amount the queue says it needs.
+ *
+ * The loop is a PI controller on the queue level with a 1.5-buffer setpoint.
+ * Its output is a per-frame resample STEP (input frames consumed per output
+ * frame): below 1 stretches the frame and produces more samples, above 1
+ * shrinks it. Both terms are clamped so the step can never leave +/-10 %, which
+ * is far more authority than the 3.5 % this needs and far less than anything
+ * audible as pitch: 3.5 % is 0.6 of a semitone spread over a whole session and
+ * constant, where the alternative is a gap in the sound twice a second.
+ *
+ * The resampler is linear interpolation with the phase and the last input frame
+ * carried across buffers, so there is no discontinuity at a frame boundary -
+ * which a naive per-buffer resample would put in twice a second by itself.
+ */
+static s32 rateMatch = 1;
+
+/**
+ * Audio.RateMatchMaxPct - how far the loop is allowed to stretch or shrink a
+ * frame, as a percentage. **1, and 1 is also the ceiling** (D-078).
+ *
+ * The loop's only job is the clock mismatch between the engine's production
+ * (368 samples per 60 Hz tick, i.e. 0.27 % over 22020) and the device's
+ * consumption. Measured once the engine's own governor stopped fighting it
+ * (M-041): the phone settles within +/-0.1 % of neutral. One percent is ten
+ * times that and is about a sixth of a semitone - the most the loop may ever
+ * bend the sound.
+ *
+ * It used to be 10, and that was the stutter-then-chipmunk fault: a hitch
+ * empties the queue, the engine then renders the whole hitch's audio in one
+ * frame (diffframe60 is the hitch's length in ticks), the queue jumps to 8-16k
+ * samples, and the integrator wound to the 10 % clamp and spent 10-15 s
+ * playing everything 1.6 semitones high and fast while it drained (M-050). A
+ * hitch is a discontinuity, not a clock drift, and is now handled as one
+ * (audioEndFrame: re-prime after an underrun, drop to the setpoint with a fade
+ * after a burst). A pd.ini written by an older build carries 10; it is clamped
+ * to this ceiling when read, with a log line, and saved back as 1.
+ */
+static s32 rateMatchMaxPct = 1;
+#define PD_AUDIO_RATE_MAX_PCT 1
+
+/** The setpoint, in samples: one and a half device buffers. */
+#define PD_AUDIO_SETPOINT (bufferSize + bufferSize / 2)
+/**
+ * Above this a push means a burst arrived (a hitch's catch-up): resync. Three
+ * device buffers over the setpoint (4608 samples, 209 ms): the simulator's
+ * audio unit sometimes pulls two buffers late and then two at once, which put
+ * an honest steady state at 3460 (M-050); a hitch of 200 ms or more lands well
+ * above it. Smaller hitches stay inside the loop's 1 % authority.
+ */
+#define PD_AUDIO_HIGHMARK (PD_AUDIO_SETPOINT + 3 * bufferSize)
+/**
+ * A drop ends at the first push that finds the queue at or below the setpoint;
+ * the few milliseconds of silence that bring it back up to exactly the
+ * setpoint go in at the faded junction, where the sound is already being cut.
+ */
+#define PD_AUDIO_RESUME (PD_AUDIO_SETPOINT)
+/** Inside setpoint +/- this the integrator learns; outside it is frozen. */
+#define PD_AUDIO_BAND (bufferSize)
+/** Length of the fade at a resync, in stereo frames (5.8 ms at 22020 Hz). */
+#define PD_AUDIO_FADE 128
+
+/* PI gains on the FILTERED queue level (an exponential average over ~32
+ * pushes, half a second, so the one-device-buffer sawtooth of every pull is
+ * not fed back as a wobble in pitch). Normalised error 1.0 = one setpoint off.
+ * KP: 1024 samples off is 0.67 %. KI: learns a 0.3 % drift in ~15 s. */
+#define PD_AUDIO_KP 0.01f
+#define PD_AUDIO_KI 0.00002f
+#define PD_AUDIO_LEVEL_ALPHA (1.0f / 32.0f)
+
+static float rateStep = 1.0f;     /* input frames per output frame */
+static float rateInteg = 0.0f;
+static float rateLevel = -1.0f;   /* filtered queue level; <0 = not yet seeded */
+static s32 rateDropping = 0;      /* a burst is being dropped back to the setpoint */
+static s16 *fadeBuf = NULL;
+static u32 fadeBufSize = 0;
+/** Resyncs (D-078): re-primes after an underrun, burst drops, samples dropped. */
+s32 g_PdAudioResyncUnder = 0;
+s32 g_PdAudioResyncOver = 0;
+s32 g_PdAudioDroppedSamples = 0;
+s32 g_PdAudioRateMinMilli = 10000;
+s32 g_PdAudioRateMaxMilli = 10000;
+static float ratePhase = 0.0f;    /* fractional read position carried over */
+static s16 ratePrev[2] = { 0, 0 };/* last input frame of the previous buffer */
+static s16 *rateBuf = NULL;
+static u32 rateBufFrames = 0;
+static s32 rateOutSamples = 0;    /* what the last push actually handed over */
+
+static float pdClampf(float v, float lo, float hi)
+{
+	return v < lo ? lo : (v > hi ? hi : v);
+}
+
+/** One PI step, from the queue level this push. */
+static void audioIosRateUpdate(s32 queued)
+{
+	const float setpoint = (float)PD_AUDIO_SETPOINT;
+	float err, adj;
+
+	if (setpoint <= 0.0f) {
+		return;
+	}
+	if (rateLevel < 0.0f) {
+		rateLevel = (float)queued;
+	} else {
+		rateLevel += ((float)queued - rateLevel) * PD_AUDIO_LEVEL_ALPHA;
+	}
+	/* Positive when the queue is BELOW the setpoint, i.e. produce more. */
+	err = pdClampf((setpoint - rateLevel) / setpoint, -1.0f, 1.0f);
+
+	{
+		const float lim = (float)rateMatchMaxPct / 100.0f;
+		/* Anti-windup: the integrator is the loop's estimate of the clock
+		 * mismatch and learns only while the queue is in its working band.
+		 * Outside it the queue is recovering from a discontinuity, which is
+		 * not drift and must not be remembered as drift. */
+		if (fabsf(rateLevel - setpoint) <= (float)PD_AUDIO_BAND) {
+			rateInteg = pdClampf(rateInteg + PD_AUDIO_KI * err, -lim, lim);
+		}
+		adj = pdClampf(PD_AUDIO_KP * err + rateInteg, -lim, lim);
+	}
+
+	/* adj > 0 means more output frames, which is a SMALLER step. */
+	rateStep = 1.0f / (1.0f + adj);
+}
+
+/**
+ * Linear-interpolating resample of one frame's stereo s16 at the current step.
+ *
+ * Returns the buffer to queue and writes its length in bytes to outLen. The
+ * phase and the previous input frame are state, so consecutive calls join
+ * seamlessly.
+ */
+static const s16 *audioIosRateConvert(const s16 *in, u32 len, u32 *outLen)
+{
+	const u32 inFrames = len / 4u;
+	u32 maxOut, n = 0;
+	float pos;
+
+	if (!rateMatch || inFrames == 0 || rateStep <= 0.5f || rateStep >= 2.0f) {
+		*outLen = len;
+		return in;
+	}
+
+	/* Room for the worst case the clamps allow, plus one. */
+	maxOut = (u32)((float)inFrames * (1.0f + (float)rateMatchMaxPct / 100.0f)) + 4u;
+	if (rateBufFrames < maxOut) {
+		s16 *grown = (s16 *)realloc(rateBuf, (size_t)maxOut * 4u);
+		if (!grown) {
+			*outLen = len;
+			return in;
+		}
+		rateBuf = grown;
+		rateBufFrames = maxOut;
+	}
+
+	/* pos runs over [0, inFrames]: 0 is the PREVIOUS buffer's last frame and
+	 * i is in[i-1], which is what makes the join continuous. */
+	for (pos = ratePhase; pos <= (float)inFrames && n < maxOut; pos += rateStep) {
+		const u32 i = (u32)pos;
+		const float f = pos - (float)i;
+		const s16 *a = (i == 0) ? ratePrev : &in[(i - 1) * 2];
+		const s16 *b = (i >= inFrames) ? &in[(inFrames - 1) * 2] : &in[i * 2];
+
+		rateBuf[n * 2 + 0] = (s16)lrintf((float)a[0] + ((float)b[0] - (float)a[0]) * f);
+		rateBuf[n * 2 + 1] = (s16)lrintf((float)a[1] + ((float)b[1] - (float)a[1]) * f);
+		n++;
+	}
+
+	ratePhase = pos - (float)inFrames;
+	if (ratePhase < 0.0f) {
+		ratePhase = 0.0f;
+	}
+	ratePrev[0] = in[(inFrames - 1) * 2 + 0];
+	ratePrev[1] = in[(inFrames - 1) * 2 + 1];
+
+	*outLen = n * 4u;
+	return rateBuf;
+}
+
+/**
+ * A copy of the frame's buffer with a short linear fade at its start (in) or
+ * end (out), so a resync joins silence or skipped audio without a click.
+ */
+static const s16 *audioIosFade(const s16 *buf, u32 len, s32 fadeIn)
+{
+	const u32 frames = len / 4u;
+	const u32 n = frames < PD_AUDIO_FADE ? frames : PD_AUDIO_FADE;
+	u32 i;
+
+	if (n == 0) {
+		return buf;
+	}
+	if (fadeBufSize < len) {
+		s16 *grown = (s16 *)realloc(fadeBuf, len);
+		if (!grown) {
+			return buf;
+		}
+		fadeBuf = grown;
+		fadeBufSize = len;
+	}
+	memcpy(fadeBuf, buf, len);
+	for (i = 0; i < n; i++) {
+		const float g = (float)i / (float)n;
+		const u32 f = fadeIn ? i : frames - 1 - i;
+		fadeBuf[f * 2 + 0] = (s16)lrintf((float)fadeBuf[f * 2 + 0] * g);
+		fadeBuf[f * 2 + 1] = (s16)lrintf((float)fadeBuf[f * 2 + 1] * g);
+	}
+	return fadeBuf;
+}
+
+/** The frame's buffer with the shell's gain in it, or the buffer itself. */
+static const s16 *audioIosApplyGain(const s16 *buf, u32 len)
+{
+	const float g = pdPlatformAudioGain();
+	u32 i, count;
+
+	// Unity is the overwhelmingly common case (no mute, full volume, nothing
+	// else playing) and it must cost nothing at all.
+	if (g >= 0.9995f) {
+		return buf;
+	}
+
+	if (gainBufSize < len) {
+		s16 *grown = (s16 *)realloc(gainBuf, len);
+		if (!grown) {
+			return buf;
+		}
+		gainBuf = grown;
+		gainBufSize = len;
+	}
+
+	count = len / sizeof(s16);
+	for (i = 0; i < count; i++) {
+		s32 v = (s32)lrintf((float)buf[i] * g);
+		if (v > 32767) {
+			v = 32767;
+		} else if (v < -32768) {
+			v = -32768;
+		}
+		gainBuf[i] = (s16)v;
+	}
+
+	return gainBuf;
+}
+
+static void audioIosQueueSilence(s32 samples)
+{
+	s16 *silence;
+
+	if (samples <= 0) {
+		return;
+	}
+	silence = (s16 *)calloc(1, (u32)samples * 4u);
+	if (!silence) {
+		return;
+	}
+	SDL_QueueAudio(dev, silence, (u32)samples * 4u);
+	g_PdAudioSilence += samples;
+	free(silence);
+}
