diff --git a/port/src/pdsched.c b/port/src/pdsched.c
index da6d3f44d..d3d043ceb 100644
--- a/port/src/pdsched.c
+++ b/port/src/pdsched.c
@@ -250,11 +250,50 @@ void schedSubmitTask(OSSched *sc, OSScTask *t)
 #ifdef PLATFORM_IOS
 // app/ios/PDShell.m — the iOS shell's per-frame entry point.
 extern void pdIosFrameHook(void);
+// app/ios/PDPacing.m — in "early" mode the display-link wait happens HERE, at
+// the top of the frame, instead of just before the present. Which is better is
+// a measurement, not a principle (D-040): the present is followed immediately
+// by the next frame's drawable acquisition, and under ANGLE-Metal THAT blocks
+// too, so waiting after the work stacks two waits on the same clock. A no-op
+// unless the mode is on.
+extern void pdIosPacingWaitAtFrameStart(void);
+#endif
+
+#ifdef PD_IOS_PROFILER
+#include "pd_frame_prof.h"
 #endif
 
 void schedStartFrame(OSSched *sc)
 {
+#ifdef PD_IOS_PROFILER
+	// The engine's frame boundary: everything the previous frame accumulated
+	// is rolled into the rings here, and the frame-to-frame interval is taken
+	// from this point (app/gfx/pd_frame_prof.c).
+	//
+	// LOOP closes FIRST, before the roll, so the time the engine spent in its
+	// own outer while-loop since the last schedEndFrame is charged to the frame
+	// it belongs to rather than to the next one.
+	pdProfEnd(PDPROF_LOOP);
+	pdProfFrame();
+#endif
+#ifdef PLATFORM_IOS
+#ifdef PD_IOS_PROFILER
+	// The pacer's wait lives here now (D-040), so this is the row that carries
+	// the frame's slack.
+	pdProfBegin(PDPROF_PACE);
+#endif
+	pdIosPacingWaitAtFrameStart();
+#ifdef PD_IOS_PROFILER
+	pdProfEnd(PDPROF_PACE);
+#endif
+#endif
+#ifdef PD_IOS_PROFILER
+	pdProfBegin(PDPROF_STARTF);
+#endif
 	videoStartFrame();
+#ifdef PD_IOS_PROFILER
+	pdProfEnd(PDPROF_STARTF);
+#endif
 }
 
 void schedAudioFrame(OSSched *sc)
@@ -294,7 +333,18 @@ void schedEndFrame(OSSched *sc)
 	// this frame rather than the next. Everything the shell does to the engine
 	// happens here; nothing else in the app touches engine state off-thread.
 	// app/ios/PDShell.m.
+#ifdef PD_IOS_PROFILER
+	// The shell's call is UIKit and CoreAnimation work on the GAME thread and
+	// therefore inside the frame budget. It gets its own row.
+	pdProfBegin(PDPROF_SHELL);
+#endif
 	pdIosFrameHook();
+#ifdef PD_IOS_PROFILER
+	pdProfEnd(PDPROF_SHELL);
+#endif
+#endif
+#ifdef PD_IOS_PROFILER
+	pdProfBegin(PDPROF_SCHED);
 #endif
 
 #if PAL
@@ -335,7 +385,16 @@ void schedEndFrame(OSSched *sc)
 	schedAudioFrame(sc);
 	schedRenderCrashPeriodically(sc->frameCount);
 	videoSetFrameStep(g_Vars.diffframe240);
+#ifdef PD_IOS_PROFILER
+	// Ends before videoEndFrame() on purpose: what that does is ENDF, and a
+	// row that contained another row would say nothing.
+	pdProfEnd(PDPROF_SCHED);
+	pdProfBegin(PDPROF_ENDF);
+#endif
 	videoEndFrame();
+#ifdef PD_IOS_PROFILER
+	pdProfEnd(PDPROF_ENDF);
+#endif
 
 	if (g_MainIsBooting == 0) {
 		schedConsiderScreenshot();
@@ -343,6 +402,13 @@ void schedEndFrame(OSSched *sc)
 
 	// check for vid mode changes
 	__scUpdateViMode();
+
+#ifdef PD_IOS_PROFILER
+	// Everything from here to the next schedStartFrame is the engine's own
+	// outer loop (pdmain.c): the tick gate's re-check and Game.ExtraSleep's
+	// nanosleep. Closed at the top of schedStartFrame, before the roll.
+	pdProfBegin(PDPROF_LOOP);
+#endif
 }
 
