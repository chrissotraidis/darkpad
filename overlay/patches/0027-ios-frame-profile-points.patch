 			SDL_UnlockMutex(lock);
@@ -1340,7 +1357,8 @@ const u8 *xblaTexRecordAlphaMap(u32 record, s32 *outSize)
 	}
 
 	if (!alphaTried[record]) {
-		u8 *rgba = xblaTexDecode(record, &width, &height);
+		u8 *rgba;
