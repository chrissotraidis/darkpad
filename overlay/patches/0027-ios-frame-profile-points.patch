diff --git a/port/fast3d/gfx_sdl2.cpp b/port/fast3d/gfx_sdl2.cpp
index 56df84d34..57cc42ac2 100644
--- a/port/fast3d/gfx_sdl2.cpp
+++ b/port/fast3d/gfx_sdl2.cpp
@@ -28,6 +28,10 @@ extern "C" int pdAngleGetSwapInterval(void);
 extern "C" int pdIosPacingWaitForPresent(void);
 #endif
 
+#ifdef PD_IOS_PROFILER
+#include "pd_frame_prof.h"
+#endif
+
 static SDL_Window* wnd;
 static SDL_GLContext ctx;
 static SDL_Renderer* renderer;
@@ -498,10 +502,25 @@ static void gfx_sdl_swap_buffers_begin(void) {
     // says the next frame is due, and presents once. A 0 answer means the app
     // is backgrounded: skip the present rather than swap into a CAMetalLayer
     // drawable the system has taken back.
+#ifdef PD_IOS_PROFILER
+    // PACE is SLACK, not cost: it is how long the frame had left over after
+    // everything else. It goes to zero exactly when the game stops making the
+    // rate, which is what makes it the first row to read.
+    pdProfBegin(PDPROF_PACE);
+    const int present = pdIosPacingWaitForPresent();
+    pdProfEnd(PDPROF_PACE);
+    if (!present) {
+        return;
+    }
+    pdProfBegin(PDPROF_SWAP);
+    pdAngleSwapBuffers();
+    pdProfEnd(PDPROF_SWAP);
+#else
     if (!pdIosPacingWaitForPresent()) {
         return;
     }
     pdAngleSwapBuffers();
+#endif
 #else
     if (target_fps) {
         sync_framerate_with_timer();
