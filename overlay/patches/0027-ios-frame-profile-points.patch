diff --git a/port/src/xblatex.c b/port/src/xblatex.c
index f7b834266..618ba3e88 100644
--- a/port/src/xblatex.c
+++ b/port/src/xblatex.c
@@ -145,6 +145,23 @@ static u32 xblaTexBE32(const u8 *p)
 
 static u8 *xblaTexDecode(u32 record, s32 *outWidth, s32 *outHeight);
 
+#ifdef PD_IOS_PROFILER
+#include "pd_frame_prof.h"
+// An STFS read + LZX inflate + untile, timed at every call site. Upstream
+// measures this as a hitch and not a per-frame cost (CLAUDE-notes/
+// performance.md: 45 decodes in a 2400-frame match, median 4 ms, worst
+// 31.8 ms); this is how that is checked on a phone.
+#define PD_XBLA_DECODE(dst, rec, w, h) \
+	do { \
+		pdProfBegin(PDPROF_XBLA); \
+		pdProfCount(PDPROF_XBLA); \
+		(dst) = xblaTexDecode((rec), (w), (h)); \
+		pdProfEnd(PDPROF_XBLA); \
+	} while (0)
+#else
+#define PD_XBLA_DECODE(dst, rec, w, h) ((dst) = xblaTexDecode((rec), (w), (h)))
+#endif
+
 static void xblaTexCloseUp(void)
 {
 	x360StfsStreamClose(&stream);
