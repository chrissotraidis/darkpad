+
+#ifndef PLATFORM_N64
+/** Upstream's 1100, raised on iOS by overlay 0028 - see audiomgr.c. */
+extern s32 g_AmgrThrottleSamples;
+#endif
 #endif
 
 #endif
diff --git a/src/lib/audiomgr.c b/src/lib/audiomgr.c
index 7791798de..b381599fd 100644
--- a/src/lib/audiomgr.c
+++ b/src/lib/audiomgr.c
@@ -321,6 +321,24 @@ void amgrHandleDoneMsg(AudioInfo *info)
 }
 
 #ifndef PLATFORM_N64
+/**
+ * The queue level, in samples, past which a frame renders 184 instead of 368.
+ *
+ * Upstream's literal 1100, and on iOS it is raised above the level this port
+ * deliberately holds the queue at (D-042). A governor whose trip point sits
+ * BELOW the setpoint of the thing controlling the queue throttles production
+ * for ever, and nothing downstream can correct it: the rate matcher (D-039)
+ * holds one and a half device buffers, the device buffer is floored at 1024
+ * samples on iOS, so 1536 > 1100 and every other tick rendered 184 instead of
+ * 368 - a 17 % production deficit that pinned the matcher at its +10 % clamp.
+ * One controller for the queue, not two.
+ */
+#ifdef PLATFORM_IOS
+s32 g_AmgrThrottleSamples = 8192;
+#else
+s32 g_AmgrThrottleSamples = 1100;
+#endif
+
 void amgrFrame(void)
 {
 	static AudioInfo *previnfo = NULL;
@@ -340,7 +358,7 @@ void amgrFrame(void)
 		osAiSetNextBuffer(previnfo->data, previnfo->frameSamples * 4);
 	}
 
-	if (somevalue > 1100 && var8005cf94 == 0) {
+	if (somevalue > g_AmgrThrottleSamples && var8005cf94 == 0) {
 		// already a lot queued, render 1 naudio frame (184 samples) this frame
 		info->frameSamples = 184;
 		var8005cf94 = 2;
