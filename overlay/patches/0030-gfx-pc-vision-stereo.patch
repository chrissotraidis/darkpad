+#if PD_VISION_STEREO
+// ---------------------------------------------------------------------------
+// THE DISPLAY LIST SAYS WHAT IT IS DRAWING (D-055, supersedes D-049's §2.4
+// three-class matrix-shape test).
+//
+// D-049 recovered the class of a projection from the SHAPE of the matrix:
+// axis-aligned meant world, a non-zero off-diagonal meant the sky's
+// camera-basis fold, and a znear of 1.5 recovered from P[3][2]/(P[2][2]-1)
+// meant the gun. On the simulator, with N64 art, that read world 187440 /
+// sky 1540 / gun 104 and looked right. On the user's headset, with 4J's XBLA
+// release on, it read
+//
+//     stereo_cls_world=2266415  stereo_cls_sky=2290014  stereo_cls_gun=247990
+//
+// — a sky count EQUAL to the world count. Half the geometry in the room was
+// taking the skew-only path, which means half of it had no eye offset at all:
+// two different depths for one scene. That is exactly what he reported, in
+// three separate complaints (dead bodies floating above the floor, doors
+// "looking wrong", going down ramps "trippy, depth off").
+//
+// The cause is that the shape of P is not a property of the subject. PD's
+// lists multiply into the projection (G_MTX_MUL with G_MTX_PROJECTION), and
+// 4J's mesh lists do it a great deal; the moment they do, the product stops
+// being axis-aligned and the shape test calls it sky. No refinement of the
+// test fixes that, because the information is not in the matrix.
+//
+// So the ENGINE says it. A tagged G_NOOP (src/include/gbiex.h, PD_DLTAG_*)
+// names the class of the NEXT projection load, and gfx_sp_matrix latches it;
+// an untagged load — which is all thirty-odd of the others in this engine — is
+// WORLD, and a MUL into the projection keeps whatever class the load had.
+// Only three sites in the whole tree carry a tag: the sky's projection
+// (vi0000ab78, vi.c), the gun's (vi0000aca4 and viSetPerspectiveWithFov, by
+// the znear THEY WERE CALLED WITH rather than one read back out of a matrix),
+// and menuRender's own flat span.
+// ---------------------------------------------------------------------------
+struct PDStereoState {
+    int pending_class;  // the class the next projection LOAD will take
+    int p_class;        // the class of the projection now in rsp.P_matrix
+    int flat_span;      // inside menuRender: flatten everything
+};
+static PDStereoState pd_stereo = { PD_DLCLASS_WORLD, PD_DLCLASS_WORLD, 0 };
+
+/** The tagged-G_NOOP reader. Untagged noops (gDPSetBlendMask) have w1 == 0. */
+static void gfx_stereo_dl_tag(uint32_t w1) {
+    if (!PD_DLTAG_IS_OURS(w1)) {
+        return;
+    }
+    switch (PD_DLTAG_PAYLOAD(w1)) {
+        case PD_DLSPAN_FLAT_BEGIN: pd_stereo.flat_span = 1; break;
+        case PD_DLSPAN_FLAT_END:   pd_stereo.flat_span = 0; break;
+        case PD_DLCLASS_SKY:       pd_stereo.pending_class = PD_DLCLASS_SKY; break;
+        case PD_DLCLASS_GUN:       pd_stereo.pending_class = PD_DLCLASS_GUN; break;
+        default:                   pd_stereo.pending_class = PD_DLCLASS_WORLD; break;
+    }
+}
+
+/** Both eyes start from the same state, so both walks read the same tags. */
+static void gfx_stereo_reset_classes(void) {
+    pd_stereo.pending_class = PD_DLCLASS_WORLD;
+    pd_stereo.p_class = PD_DLCLASS_WORLD;
+    pd_stereo.flat_span = 0;
+}
+
+/**
+ * The per-eye projection, from the mono one (plan §2.4, D-049's arithmetic).
+ *
+ * PD's matrices are ROW-vector (v * M): guPerspectiveF writes P[2][3] = -1 and
+ * P[3][2] = 2nf/(n-f), and gfx_matrix_mul forms MP = MV * P. So folding a view
+ * translation T = translate(-e, 0, 0) into P is exactly (T * P), whose only
+ * changed row is row 3:
+ *
+ *     eyeP[3][i] = P[3][i] - e * P[0][i]
+ *
+ * and the convergence skew - which makes the two eyes coincide at distance C
+ * instead of at infinity - is a constant NDC x shift of +a*e/C. A term added to
+ * P[2][0] contributes d*z to clip x and d*z/w = -d to NDC x (w = -z), so the
+ * term is -a*e/C. `e` is signed: +e is the RIGHT eye.
+ *
+ * FOUR RULES, one per class:
+ *
+ *  1. WORLD - the full fold: translation plus the skew at the crosshair plane.
+ *     Every untagged projection in the engine, which is all of them but four.
+ *
+ *  2. SKY - vi0000ab78 (vi.c:527) multiplies the camera's ROTATION into P and
+ *     loads identity as the modelview. A translation folded into that matrix is
+ *     a WORLD-space shift rather than a view-space one (the rotation sits
+ *     between them), and it is not wanted anyway: the sky is drawn at 2 x zfar,
+ *     where the correct disparity is exactly the convergence skew's infinity
+ *     term. SKEW ONLY. (harbourmasters §2.13's camera-basis fold.)
+ *
+ *  3. GUN - and this is the one D-049 got WRONG, not merely imprecisely.
+ *
+ *     D-049 kept the full translation fold and set C_gun = znear = 1.5. The NDC
+ *     x shift a convergence C contributes is a*e/C, so at C = 1.5 with the
+ *     default half-separation e = 3.15 that is 2.1 * a ~ 2.7 NDC UNITS - and
+ *     NDC is [-1, 1]. The viewmodel was shifted more than a whole screen width
+ *     sideways and drew entirely outside the frustum, in both eyes. That is why
+ *     the gun class counter read 247990 on the headset (the branch was TAKEN)
+ *     while the user could see no gun at all. `C_gun = znear` reads like quake3e
+ *     D-028 v2 but it is not: the gun's znear is 1.5 PD units, a centimetre and
+ *     a half, and the viewmodel's geometry sits tens of units away. Converging
+ *     at a plane thirty times nearer than the subject is a divergence, not a
+ *     convergence.
+ *
+ *     What D-028 v2 actually asks for is that the weapon sit AT the panel and
+ *     never in front of it. So the viewmodel converges at ITS OWN DEPTH, taken
+ *     from the modelview that is being multiplied in right now (row 3 of a
+ *     row-vector modelview is the model origin in view space, so |mv[3][2]| is
+ *     the depth of the thing about to be drawn), and its separation is scaled
+ *     by that depth against the world's convergence:
+ *
+ *         C_gun = |mv[3][2]|,  e_gun = e * C_gun / conv
+ *
+ *     Two things fall out. The panel-plane skew a*e_gun/C_gun = a*e/conv is
+ *     IDENTICAL to the world's, so the gun's convergence plane is the world's
+ *     convergence plane, which is the panel. And the gun's origin lands at zero
+ *     disparity while vertices nearer or further within the weapon keep a real,
+ *     correctly-signed disparity of 2*a*e*(d'-d)/(conv*d') - about a quarter of
+ *     a per cent of the screen width across a gun's length, which is the
+ *     comfortable end of "plausible" rather than the diplopic end.
+ *
+ *     `3d gunconv <units>` replaces C_gun with a fixed plane (and scales e_gun
+ *     to match) for the user's one A/B round, exactly as the plan intended.
+ *
+ *  4. FLAT - no fold at all, so the two eyes are bit-identical and the content
+ *     sits exactly ON the panel. Two things take it:
+ *       * menuRender's flat span (Q-026, answered "flatten"). PD's dialogs are
+ *         NOT the matrix-free NDC rectangles §2.4 assumed - most of the chrome
+ *         is projected geometry through func0f0d479c's own frustum - so under
+ *         the world fold the pause menu had depth, and in the headset it
+ *         intersected the world.
+ *       * an ORTHOGRAPHIC projection, which is sm64's own P[3][3] > 0.5 gate.
+ *         §2.4 asserted there is no orthographic matrix in this engine and that
+ *         is simply false: camGetOrthogonalMtxL() is loaded at a dozen sites
+ *         (the star field, explosion and smoke sprites, shards, bg.c's
+ *         portals). w is 1 there, so both the translation fold and the skew
+ *         degenerate into depth-dependent nonsense; and a sprite billboarded in
+ *         an orthographic projection has no parallax to show anyway.
+ *
+ * Returns false when 3D is off, in which case out[][] is untouched.
+ */
+static bool gfx_stereo_projection(const float P[4][4], const float mv[4][4],
+                                  float out[4][4]) {
+    float e = 0.0f, conv = 0.0f, gunConv = 0.0f;
+    if (!pdVisionStereoFold(&e, &conv, &gunConv)) {
+        return false;
+    }
+    memcpy(out, P, 16 * sizeof(float));
+    if (e == 0.0f) {
+        // Stereo Depth 0 %: the mono projection in both eyes, bit for bit. The
+        // gate leans on this - an L/R pair taken at 0 % must be pixel-identical
+        // and the eye must still reproduce the 2D oracle frame.
+        return true;
+    }
+
+    const float a = P[0][0];
+    if (a == 0.0f || conv <= 0.0f) {
+        return false;
+    }
+
+    // The class, in the order that decides it: a span beats a shape, a shape
+    // beats a tag. (An orthographic matrix inside the menu span is flat either
+    // way, so the order only matters for the counters.)
+    int cls = pd_stereo.p_class;
+    if (pd_stereo.flat_span || P[3][3] > 0.5f) {
+        cls = PD_DLCLASS_FLAT;
+    }
+    pdVisionStereoNoteClass(cls);
+
+    if (cls == PD_DLCLASS_FLAT) {
+        // Untouched: identical in both eyes, and on the panel.
+        return true;
+    }
+
+    float C = conv;
+    float eEye = e;
+    if (cls == PD_DLCLASS_GUN) {
+        // The viewmodel's own depth, or the A/B's fixed plane.
+        float d = fabsf(mv[3][2]);
+        if (!(d > 1.0f)) {
+            d = 1.0f;       // a modelview with no translation: nothing to converge on
+        }
+        if (d > 4000.0f) {
+            d = 4000.0f;
+        }
+        C = (gunConv > 0.0f) ? gunConv : d;
+        eEye = e * C / conv;
+        pdVisionStereoNoteGunDepth(d);
+    }
+
+    if (cls != PD_DLCLASS_SKY) {
+        for (int i = 0; i < 4; i++) {
+            out[3][i] = P[3][i] - eEye * P[0][i];
+        }
+    }
+    // The skew: the whole of the sky's disparity, and the convergence of the
+    // world's and the gun's.
+    out[2][0] += -a * eEye / C;
+    return true;
+}
+
+/** MP = MV * (the eye's P). Called at the only two sites that form MP. */
+static void gfx_stereo_update_mp(const float mv[4][4]) {
+    float eyeP[4][4];
+    if (gfx_stereo_projection(rsp.P_matrix, mv, eyeP)) {
+        gfx_matrix_mul(rsp.MP_matrix, mv, eyeP);
+    } else {
+        gfx_matrix_mul(rsp.MP_matrix, mv, rsp.P_matrix);
+    }
+}
+#define PD_MP_UPDATE(mv) gfx_stereo_update_mp(mv)
+#else
+#define PD_MP_UPDATE(mv) gfx_matrix_mul(rsp.MP_matrix, (mv), rsp.P_matrix)
+#endif
