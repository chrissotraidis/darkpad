+/**
+ * One eye's worth of frame: the whole of what gfx_run used to be.
+ *
+ * In 2D it runs once and nothing has changed. In 3D it runs TWICE per host
+ * frame at the same game time, and every line of it is deliberately identical
+ * for both eyes - including gfx_sp_reset() at the top (the display list loads
+ * its own P and modelview, vi.c) and the resolve/grade/readback tail, which
+ * follow the current eye through patch 0031's framebuffer-0 redirect.
+ *
+ * Running it twice must not change the GAME. That is not obvious and it is not
+ * assumed: the M3 gate runs the M-001 seeded replay with 3D on at Stereo Depth
+ * 0 % and requires the eye's frame 1500 to reproduce the committed oracle frame
+ * while `gfx: N draws` reads exactly twice the oracle's counters. If anything in
+ * gfx_run_dl ever acquires frame-level state, that is the assertion that catches
+ * it.
+ */
+static void gfx_run_eye(Gfx* commands) {
 #ifdef PD_IOS_PROFILER
     // The prologue, which is where ANGLE-Metal asks CoreAnimation for the next
     // drawable - and blocks if they are all in flight. On a 120 Hz panel that
@@ -8745,7 +9043,17 @@ extern "C" void gfx_run(Gfx* commands) {
 
     // Last chance to read the frame back: swap_buffers_begin() presents it and
     // leaves the back buffer undefined.
-    if (gfx_pre_swap_callback) {
+    //
+    // ONE EYE ONLY in 3D. The callback reads framebuffer 0, which is whichever
+    // eye is bound, and writes a file - so running it for both eyes would write
+    // the PNG twice and leave whichever finished last. The capture eye is R by
+    // default and PD_VP3D_SHOWEYE's eye when that is set, which is what makes
+    // two scripted replays an L-vs-R measurement.
+    if (gfx_pre_swap_callback
+#if PD_VISION_STEREO
+            && pdVisionEyeIsCapture(pdVisionGetEye())
+#endif
+       ) {
         gfx_pre_swap_callback();
     }
 
@@ -8753,9 +9061,32 @@ extern "C" void gfx_run(Gfx* commands) {
     pdProfEnd(PDPROF_GFXEND);
 #endif
 
+#if PD_VISION_STEREO
+    // Counted here rather than at the top: an eye that was started but dropped
+    // (gfx_wapi->start_frame() said no) is not an eye that was rendered, and
+    // `eye_renders == 2 x frames` has to stay a fact rather than a hope.
+    pdVisionEyeNoteRender();
+#endif
+
+    // In 3D this is the publish, and it is a no-op for eye L: the compositor may
+    // only ever see a ring slot whose BOTH eyes are finished
+    // (app/gfx/gfx_angle_egl.mm -> pdVisionEyePublish).
     gfx_wapi->swap_buffers_begin();
 }
 
+extern "C" void gfx_run(Gfx* commands) {
+    ++num_dls;
+#if PD_VISION_STEREO
+    if (pdVisionEyesPerFrame() > 1) {
+        // Bounds the producer (frames in flight <= 2) and selects eye L.
+        pdVisionEyeBeginPair();
+        gfx_run_eye(commands);
+        pdVisionSetEye(PD_EYE_RIGHT);
+    }
+#endif
+    gfx_run_eye(commands);
+}
