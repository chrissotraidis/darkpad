     }
 
     glBlitFramebuffer(srcX0, srcY0, srcX1, srcY1, dstX0, dstY0, dstX1, dstY1, GL_COLOR_BUFFER_BIT, GL_NEAREST);
 
-    glBindFramebuffer(GL_FRAMEBUFFER, framebuffers[current_framebuffer].fbo);
+    const GLuint cur_fbo = framebuffers[current_framebuffer].fbo;
+    glBindFramebuffer(GL_FRAMEBUFFER, cur_fbo);
 
-    glReadBuffer(GL_BACK);
+    glReadBuffer(cur_fbo ? GL_COLOR_ATTACHMENT0 : GL_BACK);
 
     glEnable(GL_SCISSOR_TEST);
 }
