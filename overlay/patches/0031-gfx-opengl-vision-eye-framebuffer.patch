@@ -2752,18 +2808,23 @@ void gfx_opengl_copy_framebuffer(int fb_dst, int fb_src, int left, int top, bool
         std::swap(dstY0, dstY1);
     }
 
-    if (fb_src == 0) {
+    if (fb_src == 0 && src.fbo == 0) {
