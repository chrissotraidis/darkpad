+#define PD_DLTAG_DEPTH_BIT    0x8000u
+#define PD_DLTAG_DEPTH(d)     (PD_DLTAG_DEPTH_BIT | ((unsigned int)(d) & 0x7fffu))
+#define PD_DLTAG_SCALE_BIT    0x4000u
+#define PD_DLTAG_SCALE_SHIFT  1024.0f
+#define PD_DLTAG_SCALE(s)     (PD_DLTAG_SCALE_BIT | \
+		((unsigned int)((s) * PD_DLTAG_SCALE_SHIFT) & 0x3fffu))
