+/**
+ * D-061: 1/d, softly saturated at `qm`.
+ *
+ * A hard `min(q, qm)` is continuous in VALUE, so it shows no crease in a still
+ * frame, but its slope breaks at the knee and a surface sliding through the
+ * plane changes its rate of approach in one frame. This is C1 and monotone, and
+ * it is one divide:
+ *
+ *     q' = qm - dq / (1 + (q - q0)/dq)          for q > q0
+ *
+ * At q0 it is q0 with slope 1; as q grows it approaches qm and never reaches
+ * it, which is what makes the viewmodel's own plane at U*G a STRICT bound.
+ */
+static inline float gfx_stereo_soft_q(float q, float q0, float qm, float dq) {
+    if (q <= q0 || dq <= 0.0f) {
+        return q;
+    }
+    return qm - dq / (1.0f + (q - q0) / dq);
+}
 
