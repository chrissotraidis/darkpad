diff --git a/src/game/sight.c b/src/game/sight.c
index 6bccbf6e2..8fc733a07 100644
--- a/src/game/sight.c
+++ b/src/game/sight.c
@@ -24,6 +24,153 @@
 #include <math.h>
 #include "video.h"
 #include "gehud.h"
+#endif
+
+// ---------------------------------------------------------------------------
+// D-064: THE RETICLE'S OWN DEPTH, for the visionOS stereo fold.
+// ---------------------------------------------------------------------------
+//
+// the user: "why can't the crosshair just have dynamic depth? like we do in the
+// quakes. instead of a fixed distance. it adjusts depending on where it
+// points?"
+//
+// It can, and this is where. The crosshair is a 2D rectangle at a screen
+// position PD computed itself, so the stereo fold never sees it and it sits at
+// zero disparity - ON the panel, at the convergence plane, whatever it is
+// pointing at. Aim at a wall a metre away and the reticle is eight metres
+// behind it; aim across a room and it is in front. Both eyes draw it in the
+// same place, so the only way to look at it is to un-fuse the wall.
+//
+// The family's answer (q2repro CL_VR_AddAimDot, quake3e's aim marker) is an
+// ENGINE-SIDE COLLISION TRACE along the aim ray, re-derived every frame and
+// unsmoothed, with the marker placed at the hit point. PD has the same trace -
+// cdExamLos08 + cdGetPos is how player.c pulls the third-person camera in and
+// how chraction.c places a bullet hole - and the same screen-to-view-ray helper
+// the sky uses (cam0f0b4c3c: a view-space direction at depth arg2, view space
+// looking down -z). So the depth is PD's own answer to "what is under the
+// crosshair", not an approximation of it, and it costs one LOS trace a frame.
+//
+// It is the VIEW DEPTH that is wanted and not the distance: cam0f0b4c3c's
+// vector has a view z of exactly -arg2, so the hit's fraction along the ray
+// TIMES arg2 is the view depth, for a centred reticle and an off-centre one
+// alike. That matters because PD's aim mode moves the crosshair to the edges.
+//
+// SMOOTHING. The siblings do not smooth, because their marker is world
+// GEOMETRY: it is at the hit point because it is drawn there. Ours is a flat
+// rectangle being shifted by a disparity we compute, and a disparity that
+// steps when the aim sweeps past a doorway is a reticle that jumps. So it is
+// smoothed in 1/d, which is the space disparity is LINEAR in - smoothing the
+// distance would crawl across a far edge and snap across a near one - with a
+// 100 ms time constant, frame-rate independent.
+#if defined(__APPLE__)
+#include <TargetConditionals.h>
+#endif
+#if defined(TARGET_OS_VISION) && TARGET_OS_VISION
+#include "lib/collision.h"
+#include "game/camera.h"
+#include "lib/mtx.h"
+
+// 1 only while the stereo fold is LIVE. This file is compiled into every
+// visionOS build, 2D included, and in 2D none of what follows may happen at
+// all: cdExamLos08 touches the collision module's own static state, so a trace
+// running under a 2D --fixed-step replay is a determinism input the macOS
+// oracle does not have — and the M-001 gate is precisely the assertion that
+// there is no such thing. It cost a gate run to learn.
+extern int pdVisionStereoIsActive(void);
+
+#define SIGHT_RETICLE_FAR   4000.0f   // the ray's length, and the sky's answer
+#define SIGHT_RETICLE_TAU   0.100f    // the smoothing time constant, seconds
+
+/**
+ * The view depth of whatever the crosshair is pointing at, smoothed, in PD
+ * units. Never 0: with no hit, no player or no level it is SIGHT_RETICLE_FAR,
+ * which the fold turns into the sky's own disparity (the far asymptote).
+ */
+static f32 sightReticleDepth(f32 crossx, f32 crossy)
+{
+	static f32 s_recip;      // the smoothed 1/d
+	struct player *player = g_Vars.currentplayer;
+	f32 pos2d[2];
+	struct coord dir;
+	struct coord far;
+	struct coord hit;
+	Mtxf *mtx;
+	f32 depth = SIGHT_RETICLE_FAR;
+	f32 target;
+	f32 k;
+
+	if (!player || !player->prop) {
+		return SIGHT_RETICLE_FAR;
+	}
+
+	// The ray, in the sky's own idiom (skyGetWorldPosFromScreenPos): a
+	// view-space direction at depth SIGHT_RETICLE_FAR, rotated into the world.
+	pos2d[0] = crossx + camGetScreenLeft();
+	pos2d[1] = crossy + camGetScreenTop();
+	cam0f0b4c3c(pos2d, &dir, SIGHT_RETICLE_FAR);
+	mtx = camGetProjectionMtxF();
+
+	if (!mtx) {
+		return SIGHT_RETICLE_FAR;
+	}
+
+	mtx4RotateVecInPlace(mtx, &dir);
+
+	far.x = player->cam_pos.x + dir.x;
+	far.y = player->cam_pos.y + dir.y;
+	far.z = player->cam_pos.z + dir.z;
+
+	if (cdExamLos08(&player->cam_pos, player->prop->rooms, &far,
+			CDTYPE_ALL, GEOFLAG_BLOCK_SIGHT) == CDRESULT_COLLISION) {
+		f32 rlen;
+		f32 hlen;
+
+		cdGetPos(&hit, __LINE__, "sight.c");
+
+		rlen = sqrtf(dir.f[0] * dir.f[0] + dir.f[1] * dir.f[1] + dir.f[2] * dir.f[2]);
+		hlen = sqrtf((hit.x - player->cam_pos.x) * (hit.x - player->cam_pos.x)
+				+ (hit.y - player->cam_pos.y) * (hit.y - player->cam_pos.y)
+				+ (hit.z - player->cam_pos.z) * (hit.z - player->cam_pos.z));
+
+		// The fraction along the ray IS the fraction of its view depth, because
+		// the ray's own view z is -SIGHT_RETICLE_FAR by construction.
+		if (rlen > 0.0001f) {
+			depth = SIGHT_RETICLE_FAR * (hlen / rlen);
+		}
+	}
+
+	if (depth < 1.0f) {
+		depth = 1.0f;
+	}
+	if (depth > SIGHT_RETICLE_FAR) {
+		depth = SIGHT_RETICLE_FAR;
+	}
+
+	// Smoothed in 1/d, frame-rate independent. g_Vars.lvupdate60 is the number
+	// of 60 Hz ticks this frame, which is the engine's own clock.
+	target = 1.0f / depth;
+
+	if (s_recip <= 0.0f) {
+		s_recip = target;
+	} else {
+		k = ((f32)g_Vars.lvupdate60 / 60.0f) / SIGHT_RETICLE_TAU;
+
+		if (k > 1.0f) {
+			k = 1.0f;
+		}
+
+		s_recip += (target - s_recip) * k;
+	}
+
+	if (s_recip <= 0.0f) {
+		return SIGHT_RETICLE_FAR;
+	}
+
+	return 1.0f / s_recip;
+}
+#endif
+
+#ifndef PLATFORM_N64
 
 #define SIGHT_COLOUR ((PLAYER_EXTCFG().crosshairhealth >= CROSSHAIR_HEALTH_ON_GREEN) ? sightGetCrosshairHealthColor(g_Vars.currentplayer->bondhealth, g_Vars.currentplayer->prop->chr->cshield * 0.125f) : PLAYER_EXTCFG().crosshaircolour)
 #define SIGHT_SCALE PLAYER_EXTCFG().crosshairsize
@@ -1721,6 +1868,20 @@ Gfx *sightDraw(Gfx *gdl, bool sighton, s32 sight)
 	}
 #endif
 
+#if defined(TARGET_OS_VISION) && TARGET_OS_VISION
+	// D-064: one trace, one tag, and every rectangle of the reticle inside the
+	// span gets it. The tag is a G_NOOP, so on every other platform this is a
+	// dead branch the preprocessor removes entirely — and in 2D on visionOS the
+	// runtime gate makes the display list byte-identical to the one the oracle
+	// walks, which is what the M-001 replay compares.
+	const bool stereo3d = pdVisionStereoIsActive() != 0;
+
+	if (stereo3d) {
+		gDPPdDlTag(gdl++, PD_DLTAG_DEPTH((s32)sightReticleDepth(crossx, crossy)));
+		gDPPdDlTag(gdl++, PD_DLSPAN_DEPTH_BEGIN);
+	}
+#endif
+
 	switch (sight) {
 	case SIGHT_DEFAULT:
 		gdl = sightDrawDefault(gdl, sighton && optionsGetSightOnScreen(g_Vars.currentplayerstats->mpindex), crossx, crossy);
@@ -1757,6 +1918,12 @@ Gfx *sightDraw(Gfx *gdl, bool sighton, s32 sight)
 		}
 	}
 
+#if defined(TARGET_OS_VISION) && TARGET_OS_VISION
+	if (stereo3d) {
+		gDPPdDlTag(gdl++, PD_DLSPAN_DEPTH_END);
+	}
+#endif
+
 	g_ScaleX = 1;
 
 	return gdl;
