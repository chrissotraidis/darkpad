+++ b/port/src/patchnotes.c
@@ -494,6 +494,18 @@ void patchnotesInit(void)
 {
 	s32 mine = patchnotesBuildNumber();
 
+#ifdef PLATFORM_IOS
+	// The popup is Dab's Mod's desktop changelog, shown once after an UPDATE
+	// of the desktop build (and, to an install whose pd.ini predates the
+	// notes, every entry ever written). On iOS an update is an OTA/SideStore
+	// install with its own notes, and these name F-keys and Check for Updates.
+	// Marked seen, so it never opens; the notes page under Check for Updates
+	// is hidden with that row (patch 0018).
+	g_Seen = mine;
+	g_PopupDone = true;
+	return;
+#endif
+
 	if (g_Seen < 0 && fsFileSize(CONFIG_PATH) <= 0) {
 		g_Seen = mine;
 		g_PopupDone = true;
