+/** Which form archivePath is, once it is known. */
+static s32 gebeanFormOf(const char *path)
+{
+	if (!archiveIsSupported(path)) {
+		return gebeanIsPackageFile(path) ? GEBEAN_FORM_PKG_FILE : GEBEAN_FORM_TREE;
+	}
+
+	return archiveFindEntry(path, GEBEAN_WANT_CHARS) ? GEBEAN_FORM_TREE
+		: gebeanArchiveHoldsPackage(path) ? GEBEAN_FORM_PKG_ARCHIVE : GEBEAN_FORM_TREE;
+}
