diff --git a/port/src/archive.c b/port/src/archive.c
index 66eeb41bb..aec9352c5 100644
--- a/port/src/archive.c
+++ b/port/src/archive.c
@@ -1041,6 +1041,408 @@ static s32 archiveExtract7zMatching(const char *path, const char *destDir, archi
 	return written;
 }
 
+/* -------------------------------------------------------------------------
+ * One large entry, as a stream (iOS port overlay 0046)
+ * ------------------------------------------------------------------------- */
+
+// How much compressed zip data is read at a time.
+#define ARCHIVE_ZIP_CHUNK (1 << 18)
+
+/**
+ * The 7z half of archiveStreamEntry(). The entry's block is decoded from its
+ * start, the bytes of the files before the entry are decoded past, and the
+ * entry's own go to the sink; decoding stops at its last byte.
+ */
+static s32 archiveStream7z(const char *path, const char *needle, archivesink sink, void *arg, u64 *size)
+{
+	struct archive7z a;
+	const CSzArEx *db;
+	CSzFolder *folder;
+	const CSzCoderInfo *coder;
+	CLzma2Dec lzma2;
+	CLzmaDec lzma;
+	UInt32 pick = (UInt32)-1;
+	UInt32 fi;
+	UInt64 skip = 0;
+	UInt64 left;
+	UInt64 packLeft;
+	UInt64 unpackLeft;
+	Byte *chunk;
+	s32 islzma2;
+	s32 result = -1;
+
+	if (!archive7zOpen(&a, path)) {
+		sysLogPrintf(LOG_ERROR, "archive: could not read %s as a 7z", path);
+		return -1;
+	}
+
+	db = &a.db;
+
+	for (UInt32 i = 0; i < db->db.NumFiles; i++) {
+		char name[ARCHIVE_MAXNAME];
+
+		if (!db->db.Files[i].IsDir && db->FileIndexToFolderIndexMap[i] != (UInt32)-1
+				&& archive7zName(db, i, name) && archiveNameHas(name, needle)
+				&& (pick == (UInt32)-1 || db->db.Files[i].Size > db->db.Files[pick].Size)) {
+			pick = i;
+		}
+	}
+
+	if (pick == (UInt32)-1) {
+		sysLogPrintf(LOG_ERROR, "archive: nothing in %s is named like %s", path, needle);
+		archive7zClose(&a);
+		return -1;
+	}
+
+	fi = db->FileIndexToFolderIndexMap[pick];
+	folder = db->db.Folders + fi;
+
+	if (folder->NumCoders != 1 || folder->NumPackStreams != 1 || folder->NumBindPairs != 0) {
+		sysLogPrintf(LOG_ERROR, "archive: %s is in a block of a kind this cannot stream", path);
+		archive7zClose(&a);
+		return -1;
+	}
+
+	coder = &folder->Coders[0];
+
+	if (coder->MethodID == ARCHIVE_7Z_LZMA2 && coder->Props.size == 1) {
+		islzma2 = 1;
+	} else if (coder->MethodID == ARCHIVE_7Z_LZMA && coder->Props.size == 5) {
+		islzma2 = 0;
+	} else {
+		sysLogPrintf(LOG_ERROR, "archive: %s is compressed with a method this cannot stream", path);
+		archive7zClose(&a);
+		return -1;
+	}
+
+	// what the block holds ahead of the entry
+	for (UInt32 i = archive7zNextInFolder(db, db->FolderStartFileIndex[fi], fi);
+			i < db->db.NumFiles && i != pick; i = archive7zNextInFolder(db, i + 1, fi)) {
+		skip += db->db.Files[i].Size;
+	}
+
+	left = db->db.Files[pick].Size;
+	*size = left;
+	packLeft = db->db.PackSizes[db->FolderStartPackStreamIndex[fi]];
+	unpackLeft = SzFolder_GetUnpackSize(folder);
+
+	if (LookInStream_SeekTo(&a.look.s, SzArEx_GetFolderStreamPos(db, fi, 0)) != SZ_OK
+			|| !(chunk = malloc(ARCHIVE_7Z_CHUNK))) {
+		archive7zClose(&a);
+		return -1;
+	}
+
+	if (islzma2) {
+		Lzma2Dec_Construct(&lzma2);
+
+		if (Lzma2Dec_Allocate(&lzma2, coder->Props.data[0], &a.alloc) != SZ_OK) {
+			free(chunk);
+			archive7zClose(&a);
+			return -1;
+		}
+
+		Lzma2Dec_Init(&lzma2);
+	} else {
+		LzmaDec_Construct(&lzma);
+
+		if (LzmaDec_Allocate(&lzma, coder->Props.data, 5, &a.alloc) != SZ_OK) {
+			free(chunk);
+			archive7zClose(&a);
+			return -1;
+		}
+
+		LzmaDec_Init(&lzma);
+	}
+
+	while (left > 0 && unpackLeft > 0) {
+		const void *inBuf = NULL;
+		size_t lookahead = 1 << 18;
+		SizeT inProcessed;
+		SizeT outLen = ARCHIVE_7Z_CHUNK;
+		SizeT pos = 0;
+		ELzmaStatus status;
+		SRes res;
+
+		if (lookahead > packLeft) {
+			lookahead = (size_t)packLeft;
+		}
+
+		if (outLen > unpackLeft) {
+			outLen = (SizeT)unpackLeft;
+		}
+
+		if (a.look.s.Look(&a.look.s, &inBuf, &lookahead) != SZ_OK) {
+			break;
+		}
+
+		inProcessed = lookahead;
+		res = islzma2
+			? Lzma2Dec_DecodeToBuf(&lzma2, chunk, &outLen, inBuf, &inProcessed, LZMA_FINISH_ANY, &status)
+			: LzmaDec_DecodeToBuf(&lzma, chunk, &outLen, inBuf, &inProcessed, LZMA_FINISH_ANY, &status);
+
+		if (res != SZ_OK || (inProcessed == 0 && outLen == 0)
+				|| a.look.s.Skip(&a.look.s, inProcessed) != SZ_OK) {
+			break;
+		}
+
+		packLeft -= inProcessed;
+		unpackLeft -= outLen;
+
+		if (skip >= outLen) {
+			skip -= outLen;
+			continue;
+		}
+
+		pos = (SizeT)skip;
+		skip = 0;
+
+		{
+			const SizeT take = (UInt64)(outLen - pos) < left ? outLen - pos : (SizeT)left;
+
+			if (!sink(chunk + pos, (u32)take, arg)) {
+				result = 0;
+				break;
+			}
+
+			left -= take;
+		}
+	}
+
+	if (left == 0) {
+		result = 1;
+	} else if (result != 0) {
+		sysLogPrintf(LOG_ERROR, "archive: %s stopped decoding with %llu bytes of the entry to go",
+				path, (unsigned long long)left);
+	}
+
+	if (islzma2) {
+		Lzma2Dec_Free(&lzma2, &a.alloc);
+	} else {
+		LzmaDec_Free(&lzma, &a.alloc);
+	}
+
+	free(chunk);
+	archive7zClose(&a);
+
+	return result;
+}
+
+/** The zip half: a stored or deflated entry, read and inflated a piece at a time. */
+static s32 archiveStreamZip(const char *path, const char *needle, archivesink sink, void *arg, u64 *size)
+{
+	FILE *f = fopen(path, "rb");
+	u8 *tail = NULL, *cdir = NULL, *in = NULL, *out = NULL;
+	off_t fileSize;
+	u32 back, eocd = 0, numEntries, cdirOfs, cdirLen;
+	u32 method = 0, csize = 0, usize = 0, localOfs = 0, best = 0;
+	s32 found = 0;
+	s32 result = -1;
+	u8 local[30];
+	u64 left, inLeft;
+	z_stream zs;
+	s32 inflating = 0;
+
+	if (!f) {
+		return -1;
+	}
+
+	if (fseeko(f, 0, SEEK_END) != 0 || (fileSize = ftello(f)) < ZIP_EOCD_MINLEN || fileSize > 0xffffffffLL) {
+		goto done;
+	}
+
+	back = (u32)fileSize < ZIP_EOCD_MAXBACK ? (u32)fileSize : ZIP_EOCD_MAXBACK;
+
+	if (!(tail = malloc(back)) || fseeko(f, fileSize - back, SEEK_SET) != 0 || fread(tail, 1, back, f) != back) {
+		goto done;
+	}
+
+	for (u32 i = ZIP_EOCD_MINLEN; i <= back; i++) {
+		if (archiveReadU32(tail + back - i) == ZIP_EOCD_SIG) {
+			eocd = back - i;
+			found = 1;
+			break;
+		}
+	}
+
+	if (!found) {
+		goto done;
+	}
+
+	found = 0;
+	numEntries = archiveReadU16(tail + eocd + 10);
+	cdirLen = archiveReadU32(tail + eocd + 12);
+	cdirOfs = archiveReadU32(tail + eocd + 16);
+
+	if (!archiveFits(cdirOfs, cdirLen, (u32)fileSize) || !(cdir = malloc(cdirLen ? cdirLen : 1))
+			|| fseeko(f, cdirOfs, SEEK_SET) != 0 || fread(cdir, 1, cdirLen, f) != cdirLen) {
+		goto done;
+	}
+
+	for (u32 i = 0, pos = 0; i < numEntries; i++) {
+		char name[ARCHIVE_MAXNAME];
+		u32 nameLen;
+
+		if (!archiveFits(pos, 46, cdirLen) || archiveReadU32(cdir + pos) != ZIP_CDIR_SIG) {
+			break;
+		}
+
+		nameLen = archiveReadU16(cdir + pos + 28);
+
+		if (nameLen == 0 || nameLen >= sizeof(name) || !archiveFits(pos + 46, nameLen, cdirLen)) {
+			break;
+		}
+
+		memcpy(name, cdir + pos + 46, nameLen);
+		name[nameLen] = '\0';
+
+		if (name[nameLen - 1] != '/' && name[nameLen - 1] != '\\' && archiveNameHas(name, needle)
+				&& (!found || archiveReadU32(cdir + pos + 24) > best)) {
+			found = 1;
+			method = archiveReadU16(cdir + pos + 10);
+			csize = archiveReadU32(cdir + pos + 20);
+			usize = best = archiveReadU32(cdir + pos + 24);
+			localOfs = archiveReadU32(cdir + pos + 42);
+		}
+
+		pos += 46 + nameLen + archiveReadU16(cdir + pos + 30) + archiveReadU16(cdir + pos + 32);
+	}
+
+	if (!found) {
+		sysLogPrintf(LOG_ERROR, "archive: nothing in %s is named like %s", path, needle);
+		goto done;
+	}
+
+	// a zip64 entry keeps its real sizes elsewhere; nothing this reads needs one
+	if (csize == 0xffffffff || usize == 0xffffffff || localOfs == 0xffffffff || (method != 0 && method != 8)) {
+		sysLogPrintf(LOG_ERROR, "archive: the entry in %s is stored in a way this cannot stream", path);
+		goto done;
+	}
+
+	if (fseeko(f, localOfs, SEEK_SET) != 0 || fread(local, 1, sizeof(local), f) != sizeof(local)
+			|| archiveReadU32(local) != ZIP_LOCAL_SIG
+			|| fseeko(f, (off_t)localOfs + 30 + archiveReadU16(local + 26) + archiveReadU16(local + 28), SEEK_SET) != 0) {
+		goto done;
+	}
+
+	if (!(in = malloc(ARCHIVE_ZIP_CHUNK)) || !(out = malloc(ARCHIVE_7Z_CHUNK))) {
+		goto done;
+	}
+
+	*size = usize;
+	left = usize;
+	inLeft = method == 0 ? usize : csize;
+
+	if (method == 8) {
+		memset(&zs, 0, sizeof(zs));
+
+		if (inflateInit2(&zs, -MAX_WBITS) != Z_OK) {
+			goto done;
+		}
+
+		inflating = 1;
+	}
+
+	result = 1;
+
+	while (left > 0) {
+		const u32 want = inLeft < ARCHIVE_ZIP_CHUNK ? (u32)inLeft : ARCHIVE_ZIP_CHUNK;
+
+		if (want == 0 || fread(in, 1, want, f) != want) {
+			result = -1;
+			break;
+		}
+
+		inLeft -= want;
+
+		if (method == 0) {
+			if (!sink(in, want, arg)) {
+				result = 0;
+				break;
+			}
+
+			left -= want;
+			continue;
+		}
+
+		zs.next_in = in;
+		zs.avail_in = want;
+
+		// until this piece of input is used up AND inflate had room to spare,
+		// which is how it says it holds nothing more back
+		for (;;) {
+			s32 zr;
+			u32 got;
+
+			zs.next_out = out;
+			zs.avail_out = ARCHIVE_7Z_CHUNK;
+			zr = inflate(&zs, Z_NO_FLUSH);
+
+			if (zr != Z_OK && zr != Z_STREAM_END) {
+				result = -1;
+				break;
+			}
+
+			got = ARCHIVE_7Z_CHUNK - zs.avail_out;
+
+			if (got > left) {
+				result = -1;
+				break;
+			}
+
+			if (got && !sink(out, got, arg)) {
+				result = 0;
+				break;
+			}
+
+			left -= got;
+
+			if (zr == Z_STREAM_END || left == 0 || (zs.avail_in == 0 && zs.avail_out > 0)) {
+				break;
+			}
+		}
+
+		if (result != 1) {
+			break;
+		}
+	}
+
+	if (result == 1 && left != 0) {
+		result = -1;
+	}
+
+done:
+	if (inflating) {
+		inflateEnd(&zs);
+	}
+
+	free(in);
+	free(out);
+	free(cdir);
+	free(tail);
+	fclose(f);
+
+	return result;
+}
+
+s32 archiveStreamEntry(const char *path, const char *needle, archivesink sink, void *arg, u64 *size)
+{
+	const char *ext = archiveExt(path);
+
+	*size = 0;
+
+	if (!strcasecmp(ext, ".zip") || !strcasecmp(ext, ".pk3")) {
+		return archiveStreamZip(path, needle, sink, arg, size);
+	}
+
+	if (!strcasecmp(ext, ".7z")) {
+		return archiveStream7z(path, needle, sink, arg, size);
+	}
+
+	sysLogPrintf(LOG_ERROR, "archive: %s is not an archive this can stream from", path);
+
+	return -1;
+}
+
 s32 archiveExtractMatching(const char *path, const char *destDir, archivefilter filter, void *arg)
 {
 	if (strcasecmp(archiveExt(path), ".zip") == 0) {
