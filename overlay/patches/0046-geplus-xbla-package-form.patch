+/**
+ * Whether the cache was unpacked from what is there now. A marker written
+ * before this patch is empty; it is still good for an archive of the loose
+ * files, which is all it could have come from.
+ */
+static s32 gebeanMarkerMatches(const char *marker)
+{
+	char have[FS_MAXPATH + 32] = "";
+	char want[FS_MAXPATH + 32];
+	FILE *fp = fopen(fsFullPath(marker), "rb");
+	size_t n;
+
+	if (!fp) {
+		return 0;
+	}
+
+	n = fread(have, 1, sizeof(have) - 1, fp);
+	fclose(fp);
+	have[n] = '\0';
+
+	while (n > 0 && (have[n - 1] == '\n' || have[n - 1] == '\r')) {
+		have[--n] = '\0';
+	}
+
+	if (n == 0) {
+		return releaseForm == GEBEAN_FORM_TREE;
+	}
+
+	gebeanSourceId(want, sizeof(want));
+
+	return strcmp(have, want) == 0;
+}
