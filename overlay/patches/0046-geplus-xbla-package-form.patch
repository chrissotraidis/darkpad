+/** What the cache's marker says it was unpacked from: the file's name and size. */
+static void gebeanSourceId(char *dst, u32 len)
+{
+	const char *base = strrchr(archivePath, '/');
+	struct stat st;
+
+	snprintf(dst, len, "%s %lld", base ? base + 1 : archivePath,
+			stat(archivePath, &st) == 0 ? (long long)st.st_size : -1ll);
+}
