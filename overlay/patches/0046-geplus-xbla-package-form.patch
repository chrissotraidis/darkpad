+/**
+ * Removes everything under dir but its entry named keep, without following a
+ * link out of it - dot files included (fsScanDir() skips them, and the marker,
+ * the spool and the no-room note are all dot files). For the cache only: what
+ * is there is the game's own and can be made again.
+ */
+static void gebeanRemoveTree(const char *dir, const char *keep)
+{
+	DIR *d = opendir(dir);
+	struct dirent *e;
+	char **names = NULL;
+	s32 count = 0, max = 0;
+
+	if (!d) {
+		return;
+	}
+
+	// the names first, the removing after: nothing is taken out from under readdir()
+	while ((e = readdir(d))) {
+		if (!strcmp(e->d_name, ".") || !strcmp(e->d_name, "..") || (keep && !strcmp(e->d_name, keep))) {
+			continue;
+		}
+
+		if (count == max) {
+			char **grown = realloc(names, (max = max ? max * 2 : 32) * sizeof(*names));
+
+			if (!grown) {
+				break;
+			}
+
+			names = grown;
+		}
+
+		names[count] = malloc(strlen(e->d_name) + 1);
+
+		if (names[count]) {
+			strcpy(names[count++], e->d_name);
+		}
+	}
+
+	closedir(d);
+
+	for (s32 i = 0; i < count; i++) {
+		char path[FS_MAXPATH + 1];
+		struct stat st;
+
+		snprintf(path, sizeof(path), "%s/%s", dir, names[i]);
+
+		if (lstat(path, &st) == 0) {
+			if (S_ISDIR(st.st_mode)) {
+				gebeanRemoveTree(path, NULL);
+				rmdir(path);
+			} else {
+				remove(path);
+			}
+		}
+
+		free(names[i]);
+	}
+
+	free(names);
+}
