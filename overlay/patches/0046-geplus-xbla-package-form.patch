index 4821e683e..57b0a6665 100644
--- a/port/include/archive.h
+++ b/port/include/archive.h
@@ -61,6 +61,26 @@ s32 archiveExtractMatching(const char *path, const char *destDir, archivefilter
  */
 void archiveGetProgress(s32 *done, s32 *total);
 
+/** Takes the next len bytes of an entry; 0 stops the stream. */
+typedef s32 (*archivesink)(const u8 *data, u32 len, void *arg);
+
+/**
+ * The largest file entry of a .7z or .zip whose name has needle in it (compared
+ * as archiveFindEntry() does), decoded as a stream and handed to sink a piece at
+ * a time, in order. *size is set to the entry's length before the first piece.
+ *
+ * For one entry too big to want in memory or on disk twice: the GoldenEye XBLA
+ * release in its Xbox 360 package form is a 740MB package inside one solid
+ * block of a .7z, and what is held at once here is the decoder's dictionary
+ * and a 1MB piece, never the entry. Nothing is written to disk.
+ *
+ * 1 when the whole entry was handed over, 0 when the sink stopped it, -1 on a
+ * fault, when nothing is named like needle, or when the entry is in a 7z block
+ * that is not one LZMA or LZMA2 coder or a zip entry that is neither stored
+ * nor deflated (or zip64). A .rar is never read here.
+ */
+s32 archiveStreamEntry(const char *path, const char *needle, archivesink sink, void *arg, u64 *size);
+
 #ifdef __cplusplus
 }
 #endif
