+/* -------------------------------------------------------------------------
+ * The release in its Xbox 360 package form (iOS port overlay 0046)
+ *
+ * The same release also comes as the console's own download: one STFS package,
+ * title 584108A9, 740MB, which is the loose files above packed whole (every
+ * file but default.xex, which the package keeps compressed, is byte for byte
+ * the same). It is found as the bare package, a folder holding it, or a .7z or
+ * .zip holding it, and its wanted files land in the same cache as an archive's
+ * - files/ at the cache's top - so everything after the unpack is unchanged.
+ *
+ * An archive holding it is one solid block, so the package cannot be read in
+ * place. It is not spooled to disk either: the block is decoded as a stream
+ * (archiveStreamEntry()) and the package's own layout is followed as it goes
+ * by. Its file table comes first; from it every wanted file's 4KB blocks are
+ * known by their offsets in the package, and each is written where it belongs
+ * as the stream passes it. What is on disk at the end is the 400MB the game
+ * reads and nothing else; what is held at once is the decoder's dictionary,
+ * a 1MB piece and the block list. A package whose wanted files are not stored
+ * in consecutive blocks needs its hash tables to be followed, which a stream
+ * cannot do, so then (and only then) the whole package is spooled into the
+ * cache first and read from there.
+ * ------------------------------------------------------------------------- */
+
+// The STFS title id at 0x360 of GoldenEye XBLA's package (Perfect Dark's is
+// 584109C2), and what an archive holding the package names it: the console's
+// own content folder, or the package's own name with no folder.
+#define GEBEAN_PKG_TITLE 0x584108a9u
+#define GEBEAN_PKG_ENTRY "584108a9/000d0000/"
+#define GEBEAN_PKG_NAME "30ba92710985645ef623d4a6ba9e8effaec62617"
+// A package is hundreds of MB; nothing smaller is opened to look.
+#define GEBEAN_PKG_MIN_SIZE (64ll << 20)
+// Spooled here when a package cannot be followed as a stream. A dot name, so
+// no scan of the cache (this file's or xblaimport.c's) ever looks at it.
+#define GEBEAN_PKG_SPOOL ".package.part"
+// Free space kept over what the unpack writes.
+#define GEBEAN_PKG_MARGIN (64ull << 20)
+
+// STFS's layout, as x360.c reads it.
+#define GEBEAN_STFS_DATA_START 0xc000
+#define GEBEAN_STFS_BLOCK      0x1000
+
+#define GEBEAN_FORM_TREE        0 // a folder or archive of the loose files
+#define GEBEAN_FORM_PKG_FILE    1 // the package itself (or in a folder)
+#define GEBEAN_FORM_PKG_ARCHIVE 2 // a .7z or .zip holding it
+
+static s32 releaseForm;
+
+// The package unpack's progress, for the notice: plain ints read without a
+// lock, as archive.c's are.
+static volatile s32 pkgFilesDone;
+static volatile s32 pkgFilesTotal;
+static volatile s32 pkgMbDone;
+static volatile s32 pkgMbTotal;
+// MB of free space the unpack needed and did not find, or 0
+static s32 pkgSpaceNeededMb;
+static s32 pkgSpaceFreeMb;
+
+s32 gebeanIsPackageFile(const char *path)
+{
+	u8 head[0x364];
+	struct stat st;
+	FILE *fp;
+	s32 ok;
+
+	if (stat(path, &st) != 0 || !S_ISREG(st.st_mode) || (long long)st.st_size < GEBEAN_PKG_MIN_SIZE) {
+		return 0;
+	}
+
+	fp = fopen(path, "rb");
+
+	if (!fp) {
+		return 0;
+	}
+
+	ok = fread(head, 1, sizeof(head), fp) == sizeof(head)
+		&& (!memcmp(head, "LIVE", 4) || !memcmp(head, "CON ", 4) || !memcmp(head, "PIRS", 4))
+		&& gebeanBE32(head + 0x360) == GEBEAN_PKG_TITLE;
+	fclose(fp);
+
+	return ok;
+}
+
+s32 gebeanArchiveHoldsPackage(const char *path)
+{
+	return archiveIsSupported(path)
+		&& (archiveFindEntry(path, GEBEAN_PKG_ENTRY) || archiveFindEntry(path, GEBEAN_PKG_NAME));
+}
+
+/** Free bytes where the cache is, or -1 when that cannot be told. */
+#ifdef PLATFORM_IOS
+// app/ios/PDXbla.m: the volume's capacity for important use, which is what the
+// system will actually make room for (it purges other apps' caches to do it).
+extern long long pdIosAvailableBytes(const char *path);
+#endif
+
+static long long gebeanFreeBytes(const char *dir)
+{
+#if defined(PLATFORM_IOS)
+	return pdIosAvailableBytes(dir);
+#elif defined(PLATFORM_WIN32)
+	(void)dir;
+	return -1;
+#else
+	struct statvfs vfs;
+
+	if (statvfs(dir, &vfs) != 0) {
+		return -1;
+	}
+
+	return (long long)vfs.f_bavail * (long long)vfs.f_frsize;
+#endif
+}
+
+/** Whether need bytes fit under dir; when not, the numbers go to the notice. */
+static s32 gebeanRoomFor(const char *dir, unsigned long long need)
+{
+	const long long have = gebeanFreeBytes(dir);
+
+	if (have < 0 || (unsigned long long)have >= need) {
+		return 1;
+	}
+
+	pkgSpaceNeededMb = (s32)((need + (1 << 20) - 1) >> 20);
+	pkgSpaceFreeMb = (s32)(have >> 20);
+	sysLogPrintf(LOG_ERROR, "gebean: unpacking GoldenEye XBLA needs %d MB free, there are %d MB",
+			pkgSpaceNeededMb, pkgSpaceFreeMb);
+
+	return 0;
+}
+
+/** A path out of the package that stays inside the cache. */
+static s32 gebeanPkgPathIsSafe(const char *path)
+{
+	const char *p = path;
+
+	if (!path[0] || path[0] == '/' || strchr(path, '\\') || strchr(path, ':')) {
+		return 0;
+	}
+
+	while (*p) {
+		const char *end = strchr(p, '/');
+		const size_t len = end ? (size_t)(end - p) : strlen(p);
+
+		if (len == 0 || (len == 1 && p[0] == '.') || (len == 2 && p[0] == '.' && p[1] == '.')) {
+			return 0;
+		}
+
+		p += len;
+
+		if (*p == '/') {
+			p++;
+		}
+	}
+
+	return 1;
+}
+
+/** Opens cache/rel for writing, making its folders. */
+static FILE *gebeanPkgCreate(const char *cache, const char *rel, const char *mode)
+{
+	char path[FS_MAXPATH + 1];
+
+	snprintf(path, sizeof(path), "%s/%s", cache, rel);
+
+	for (char *p = path + strlen(cache) + 1; *p; p++) {
+		if (*p == '/') {
+			*p = '\0';
+			fsCreateDir(path);
+			*p = '/';
+		}
+	}
+
+	return fopen(path, mode);
+}
+
+/**
+ * Every wanted file of a package on disk, read where it lies (the bare package,
+ * or the spool). Returns the files written, -1 on a fault, -2 for no room.
+ */
+static s32 gebeanPkgExtractFile(const char *pkg, const char *cache, s32 checkRoom)
+{
+	struct x360stfs stfs;
+	char name[512];
+	u8 *buf;
+	unsigned long long bytes = 0, done = 0;
+	s32 wanted = 0;
+	s32 written = 0;
+
+	if (!x360StfsOpen(&stfs, pkg)) {
+		sysLogPrintf(LOG_ERROR, "gebean: %s is not a package this can read", pkg);
+		return -1;
+	}
+
+	for (u32 i = 0; i < stfs.numFiles; i++) {
+		if (!stfs.files[i].isDir && gebeanWantEntry(x360StfsPath(&stfs, i, name, sizeof(name)), NULL)) {
+			wanted++;
+			bytes += stfs.files[i].size;
+		}
+	}
+
+	pkgFilesDone = 0;
+	pkgFilesTotal = wanted;
+	pkgMbDone = 0;
+	pkgMbTotal = (s32)(bytes >> 20);
+
+	if (checkRoom && !gebeanRoomFor(cache, bytes + GEBEAN_PKG_MARGIN)) {
+		x360StfsClose(&stfs);
+		return -2;
+	}
+
+	buf = malloc(1 << 18);
+
+	if (!buf) {
+		x360StfsClose(&stfs);
+		return -1;
+	}
+
+	for (u32 i = 0; i < stfs.numFiles && written >= 0; i++) {
+		struct x360stfsstream stream;
+		FILE *fp;
+		const u32 size = stfs.files[i].size;
+
+		if (stfs.files[i].isDir || !gebeanWantEntry(x360StfsPath(&stfs, i, name, sizeof(name)), NULL)) {
+			continue;
+		}
+
+		if (!gebeanPkgPathIsSafe(name)) {
+			sysLogPrintf(LOG_WARNING, "gebean: skipping %s in %s", name, pkg);
+			continue;
+		}
+
+		fp = gebeanPkgCreate(cache, name, "wb");
+
+		if (!fp) {
+			sysLogPrintf(LOG_ERROR, "gebean: could not write %s/%s", cache, name);
+			written = -1;
+			break;
+		}
+
+		if (size > 0) {
+			if (!x360StfsStreamOpen(&stfs, i, &stream)) {
+				written = -1;
+			}
+
+			for (u32 at = 0; written >= 0 && at < size; ) {
+				const u32 n = size - at < (1u << 18) ? size - at : (1u << 18);
+
+				if (!x360StfsStreamRead(&stream, at, n, buf) || fwrite(buf, 1, n, fp) != n) {
+					written = -1;
+					break;
+				}
+
+				at += n;
+				done += n;
+				pkgMbDone = (s32)(done >> 20);
+			}
+
+			x360StfsStreamClose(&stream);
+		}
+
+		if (fclose(fp) != 0 || written < 0) {
+			sysLogPrintf(LOG_ERROR, "gebean: could not read or write %s out of %s", name, pkg);
+			written = -1;
+			break;
+		}
+
+		written++;
+		pkgFilesDone = written;
+	}
+
+	free(buf);
+	x360StfsClose(&stfs);
+
+	return written;
+}
+
+// One 4KB block of a wanted file: where it is in the package, and where in its file.
+struct gebeanpkgblock {
+	unsigned long long ofs;
+	u32 len;
+	u32 file;
+	u32 fileOfs;
+};
+
+struct gebeanpkgfile {
+	char *path;
+	u32 size;
+	u32 got;
+	FILE *fp;
+	s32 opened;
+};
+
+struct gebeanpkgsink {
+	const char *cache;
+	char spool[FS_MAXPATH + 1];
+	FILE *spoolFp;
+	s32 spooling;               // 1 until the file table is in, 2 spooling the whole package
+	unsigned long long pos;     // package bytes seen
+	unsigned long long size;    // the package's length
+	unsigned long long tableEnd;
+	u8 head[GEBEAN_STFS_BLOCK];
+	u32 headLen;
+	u32 tableShift;
+	struct gebeanpkgblock *blocks;
+	u32 numBlocks;
+	u32 next;
+	struct gebeanpkgfile *files;
+	u32 numFiles;
+	u32 cur;                    // the file the last block went to, or ~0
+	s32 written;
+	s32 failed;                 // 1 a fault, 2 no room
+};
+
+static unsigned long long gebeanPkgBlockOffset(u32 tableShift, u32 block)
+{
+	// x360.c stfsBackingBlock(): a hash table before every 0xaa blocks, and a
+	// second level's before every 0x70e4
+	u32 adjust = 0;
+
+	if (block >= 0xaa) {
+		adjust += ((block / 0xaa) + 1) << tableShift;
+	}
+
+	if (block >= 0x70e4) {
+		adjust += ((block / 0x70e4) + 1) << tableShift;
+	}
+
+	return GEBEAN_STFS_DATA_START + (unsigned long long)(block + adjust) * GEBEAN_STFS_BLOCK;
+}
+
+static s32 gebeanPkgCompareBlocks(const void *a, const void *b)
+{
+	const struct gebeanpkgblock *x = a, *y = b;
+
+	return x->ofs < y->ofs ? -1 : x->ofs > y->ofs;
+}
+
+static void gebeanPkgFileDone(struct gebeanpkgsink *s, u32 f)
+{
+	struct gebeanpkgfile *file = &s->files[f];
+
+	if (file->fp) {
+		if (fclose(file->fp) != 0) {
+			s->failed = 1;
+		}
+
+		file->fp = NULL;
+	}
+
+	if (file->got == file->size) {
+		s->written++;
+		pkgFilesDone = s->written;
+	}
+}
+
+/** Bytes [ofs, ofs + len) of the package, as they go by, to the wanted files. */
+static void gebeanPkgFeed(struct gebeanpkgsink *s, unsigned long long ofs, const u8 *data, u32 len)
+{
+	const unsigned long long end = ofs + len;
+
+	while (!s->failed && s->next < s->numBlocks && s->blocks[s->next].ofs < end) {
+		struct gebeanpkgblock *b = &s->blocks[s->next];
+		struct gebeanpkgfile *file = &s->files[b->file];
+		const unsigned long long from = b->ofs > ofs ? b->ofs : ofs;
+		const unsigned long long to = b->ofs + b->len < end ? b->ofs + b->len : end;
+
+		if (b->file != s->cur) {
+			if (s->cur != ~0u && s->files[s->cur].fp) {
+				gebeanPkgFileDone(s, s->cur);
+			}
+
+			s->cur = b->file;
+			file->fp = gebeanPkgCreate(s->cache, file->path, file->opened ? "r+b" : "wb");
+			file->opened = 1;
+
+			if (!file->fp) {
+				sysLogPrintf(LOG_ERROR, "gebean: could not write %s/%s", s->cache, file->path);
+				s->failed = 1;
+				break;
+			}
+		}
+
+		if (from < to) {
+			const u32 n = (u32)(to - from);
+			const u32 at = b->fileOfs + (u32)(from - b->ofs);
+
+			if ((ftell(file->fp) != (long)at && fseek(file->fp, (long)at, SEEK_SET) != 0)
+					|| fwrite(data + (from - ofs), 1, n, file->fp) != n) {
+				sysLogPrintf(LOG_ERROR, "gebean: a write failed unpacking %s", file->path);
+				s->failed = 1;
+				break;
+			}
+
+			file->got += n;
+		}
+
+		if (b->ofs + b->len > end) {
+			break; // the rest of this block is in the next piece
+		}
+
+		s->next++;
+
+		if (file->got == file->size) {
+			gebeanPkgFileDone(s, b->file);
+			s->cur = ~0u;
+		}
+	}
+}
+
+/**
+ * The file table is in: which blocks are wanted and where they go. The bytes
+ * already seen are on disk in the spool, and the blocks among them are
+ * written from there. 0 on a fault (s->failed says which).
+ */
+static s32 gebeanPkgPlan(struct gebeanpkgsink *s)
+{
+	struct x360stfs stfs;
+	char name[512];
+	unsigned long long bytes = 0;
+	u32 numBlocks = 0;
+	s32 consecutive = 1;
+	u8 *buf;
+
+	fflush(s->spoolFp);
+
+	if (!x360StfsOpen(&stfs, s->spool)) {
+		sysLogPrintf(LOG_ERROR, "gebean: the package's file table did not read");
+		s->failed = 1;
+		return 0;
+	}
+
+	s->files = calloc(stfs.numFiles ? stfs.numFiles : 1, sizeof(*s->files));
+
+	if (!s->files) {
+		x360StfsClose(&stfs);
+		s->failed = 1;
+		return 0;
+	}
+
+	for (u32 i = 0; i < stfs.numFiles; i++) {
+		const struct x360stfsfile *f = &stfs.files[i];
+
+		if (f->isDir || !gebeanWantEntry(x360StfsPath(&stfs, i, name, sizeof(name)), NULL)) {
+			continue;
+		}
+
+		if (!gebeanPkgPathIsSafe(name)) {
+			sysLogPrintf(LOG_WARNING, "gebean: skipping %s in the package", name);
+			continue;
+		}
+
+		if (!f->consecutive && f->numBlocks > 1) {
+			consecutive = 0;
+		}
+
+		s->files[s->numFiles].path = malloc(strlen(name) + 1);
+
+		if (!s->files[s->numFiles].path) {
+			x360StfsClose(&stfs);
+			s->failed = 1;
+			return 0;
+		}
+
+		strcpy(s->files[s->numFiles].path, name);
+		s->files[s->numFiles].size = f->size;
+		s->numFiles++;
+		bytes += f->size;
+		numBlocks += (f->size + GEBEAN_STFS_BLOCK - 1) / GEBEAN_STFS_BLOCK;
+	}
+
+	pkgFilesTotal = (s32)s->numFiles;
+
+	if (!consecutive) {
+		// Followed by its hash tables, which a stream cannot do: the whole
+		// package goes into the spool and is read from there afterwards.
+		x360StfsClose(&stfs);
+		sysLogPrintf(LOG_NOTE, "gebean: the package's files are not stored in order; spooling it whole");
+
+		if (!gebeanRoomFor(s->cache, s->size - s->pos + bytes + GEBEAN_PKG_MARGIN)) {
+			s->failed = 2;
+			return 0;
+		}
+
+		s->spooling = 2;
+		return 1;
+	}
+
+	if (!gebeanRoomFor(s->cache, bytes + GEBEAN_PKG_MARGIN)) {
+		x360StfsClose(&stfs);
+		s->failed = 2;
+		return 0;
+	}
+
+	s->blocks = malloc((numBlocks ? numBlocks : 1) * sizeof(*s->blocks));
+
+	if (!s->blocks) {
+		x360StfsClose(&stfs);
+		s->failed = 1;
+		return 0;
+	}
+
+	for (u32 i = 0, w = 0; i < stfs.numFiles; i++) {
+		const struct x360stfsfile *f = &stfs.files[i];
+
+		if (w >= s->numFiles) {
+			break;
+		}
+
+		if (f->isDir || strcmp(x360StfsPath(&stfs, i, name, sizeof(name)), s->files[w].path) != 0) {
+			continue;
+		}
+
+		for (u32 b = 0; b * GEBEAN_STFS_BLOCK < f->size; b++) {
+			struct gebeanpkgblock *blk = &s->blocks[s->numBlocks++];
+			const u32 at = b * GEBEAN_STFS_BLOCK;
+
+			blk->ofs = gebeanPkgBlockOffset(s->tableShift, f->startBlock + b);
+			blk->len = f->size - at < GEBEAN_STFS_BLOCK ? f->size - at : GEBEAN_STFS_BLOCK;
+			blk->file = w;
+			blk->fileOfs = at;
+		}
+
+		w++;
+	}
+
+	x360StfsClose(&stfs);
+	qsort(s->blocks, s->numBlocks, sizeof(*s->blocks), gebeanPkgCompareBlocks);
+
+	// the empty ones have no blocks to wait for
+	for (u32 f = 0; f < s->numFiles; f++) {
+		if (s->files[f].size == 0) {
+			FILE *fp = gebeanPkgCreate(s->cache, s->files[f].path, "wb");
+
+			if (!fp) {
+				s->failed = 1;
+				return 0;
+			}
+
+			fclose(fp);
+			s->written++;
+		}
+	}
+
+	// what went by while the table was read in
+	buf = malloc(1 << 20);
+
+	if (!buf) {
+		s->failed = 1;
+		return 0;
+	}
+
+	for (unsigned long long at = 0; at < s->pos && !s->failed; ) {
+		const u32 n = s->pos - at < (1u << 20) ? (u32)(s->pos - at) : (1u << 20);
+
+		if (fseek(s->spoolFp, (long)at, SEEK_SET) != 0 || fread(buf, 1, n, s->spoolFp) != n) {
+			s->failed = 1;
+			break;
+		}
+
+		gebeanPkgFeed(s, at, buf, n);
+		at += n;
+	}
+
+	free(buf);
+	fclose(s->spoolFp);
+	s->spoolFp = NULL;
+	remove(s->spool);
+	s->spooling = 0;
+
+	return !s->failed;
+}
+
+static s32 gebeanPkgSink(const u8 *data, u32 len, void *arg)
+{
+	struct gebeanpkgsink *s = arg;
+	const unsigned long long at = s->pos;
+
+	s->pos += len;
+	pkgMbDone = (s32)(s->pos >> 20);
+	pkgMbTotal = (s32)(s->size >> 20);
+
+	if (!s->spooling) {
+		gebeanPkgFeed(s, at, data, len);
+		return !s->failed;
+	}
+
+	if (fwrite(data, 1, len, s->spoolFp) != len) {
+		sysLogPrintf(LOG_ERROR, "gebean: a write failed spooling the package");
+		s->failed = 1;
+		return 0;
+	}
+
+	if (s->spooling == 2) {
+		return 1;
+	}
+
+	if (s->headLen < GEBEAN_STFS_BLOCK) {
+		const u32 n = GEBEAN_STFS_BLOCK - s->headLen < len ? GEBEAN_STFS_BLOCK - s->headLen : len;
+
+		memcpy(s->head + s->headLen, data, n);
+		s->headLen += n;
+
+		if (s->headLen == GEBEAN_STFS_BLOCK) {
+			const u8 *h = s->head;
+			// the volume descriptor, as x360StfsOpen() reads it
+			const u32 headerSize = gebeanBE32(h + 0x340);
+			const u32 tableBlocks = h[0x37c] | ((u32)h[0x37d] << 8);
+			const u32 tableBlock = h[0x37e] | ((u32)h[0x37f] << 8) | ((u32)h[0x380] << 16);
+
+			if ((memcmp(h, "LIVE", 4) && memcmp(h, "CON ", 4) && memcmp(h, "PIRS", 4))
+					|| gebeanBE32(h + 0x360) != GEBEAN_PKG_TITLE || tableBlocks == 0 || tableBlocks > 0x400) {
+				sysLogPrintf(LOG_ERROR, "gebean: what the archive holds is not GoldenEye XBLA's package");
+				s->failed = 1;
+				return 0;
+			}
+
+			s->tableShift = (((headerSize + 0xfff) & 0xf000) >> 12) == 0xb ? 0 : 1;
+			s->tableEnd = gebeanPkgBlockOffset(s->tableShift, tableBlock + tableBlocks - 1) + GEBEAN_STFS_BLOCK;
+		}
+	}
+
+	if (s->tableEnd && s->pos >= s->tableEnd) {
+		return gebeanPkgPlan(s);
+	}
+
+	return 1;
+}
+
+/** The wanted files of the package form at src into cache. As gebeanPkgExtractFile(). */
+static s32 gebeanPkgUnpack(const char *src, const char *cache)
+{
+	struct gebeanpkgsink s;
+	s32 streamed;
+	s32 result;
+
+	pkgFilesDone = pkgFilesTotal = pkgMbDone = pkgMbTotal = 0;
+	pkgSpaceNeededMb = pkgSpaceFreeMb = 0;
+
+	if (releaseForm == GEBEAN_FORM_PKG_FILE) {
+		return gebeanPkgExtractFile(src, cache, 1);
+	}
+
+	memset(&s, 0, sizeof(s));
+	s.cache = cache;
+	s.spooling = 1;
+	s.cur = ~0u;
+	snprintf(s.spool, sizeof(s.spool), "%s/" GEBEAN_PKG_SPOOL, cache);
+	s.spoolFp = fopen(s.spool, "w+b");
+
+	if (!s.spoolFp) {
+		sysLogPrintf(LOG_ERROR, "gebean: could not write %s", s.spool);
+		return -1;
+	}
+
+	streamed = archiveStreamEntry(src, GEBEAN_PKG_ENTRY, gebeanPkgSink, &s, &s.size);
+
+	if (streamed < 0 && s.pos == 0) {
+		// no content folder in the archive: the package under its own name
+		streamed = archiveStreamEntry(src, GEBEAN_PKG_NAME, gebeanPkgSink, &s, &s.size);
+	}
+
+	pkgMbTotal = (s32)(s.size >> 20);
+
+	if (s.cur != ~0u && s.files[s.cur].fp) {
+		gebeanPkgFileDone(&s, s.cur);
+	}
+
+	for (u32 f = 0; f < s.numFiles; f++) {
+		if (s.files[f].fp) {
+			fclose(s.files[f].fp);
+		}
+	}
+
+	if (s.failed == 2) {
+		result = -2;
+	} else if (streamed != 1 || s.failed || s.spooling == 1) {
+		sysLogPrintf(LOG_ERROR, "gebean: the package in %s did not unpack (%d, %d)", src, streamed, s.failed);
+		result = -1;
+	} else if (s.spooling == 2) {
+		fclose(s.spoolFp);
+		s.spoolFp = NULL;
+		result = gebeanPkgExtractFile(s.spool, cache, 0);
+	} else if (s.written != (s32)s.numFiles || s.next != s.numBlocks) {
+		sysLogPrintf(LOG_ERROR, "gebean: the package ended with %d of %u files written", s.written, s.numFiles);
+		result = -1;
+	} else {
+		result = s.written;
+	}
+
