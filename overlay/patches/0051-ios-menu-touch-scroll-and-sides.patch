diff --git a/src/game/menu.c b/src/game/menu.c
index 9d6628d02..a2609a5b9 100644
--- a/src/game/menu.c
+++ b/src/game/menu.c
@@ -1532,6 +1532,61 @@ s32 menuIosDialogIsOpen(void)
 {
 	return g_Menus[0].curdialog != NULL;
 }
+
+/**
+ * One menu line as a fraction of the screen's height (D-083).
+ *
+ * The touch layer turns a vertical drag into wheel ticks, and a tick is
+ * LINEHEIGHT in the units inputMouseGetPosition() reports (the native
+ * viewport). Sized from here, the menu follows the finger instead of a number
+ * the shell would have to guess.
+ */
+f32 menuIosRowFraction(void)
+{
+	const s32 h = videoGetNativeHeight();
+	return h > 0 ? (f32)LINEHEIGHT / (f32)h : 0.05f;
+}
+
+/**
+ * Is (mx, my) on the dialog's focused item? The same walk over the dialog's
+ * own columns and rows that dialogChangeItemFocusWithMouse() does, asking a
+ * different question: it moves the focus to a FOCUSABLE item under the point,
+ * so when the point is on no item at all (a header, a gap, a label, the space
+ * around the dialog) the focus stays where it was - and a click there used to
+ * be an Accept on whatever that was.
+ */
+static bool menuIosPointOnFocusedItem(struct menudialog *dialog, s32 mx, s32 my)
+{
+	struct menu *menu = &g_Menus[g_MpPlayerNum];
+	s32 col, row;
+	s32 curx = dialog->x;
+	s32 cury;
+	s32 colwidth = 0;
+
+	if (dialog->focuseditem == NULL) {
+		return false;
+	}
+
+	for (col = 0; col < dialog->numcols; col++, curx += colwidth) {
+		s32 colindex = dialog->colstart + col;
+		colwidth = menu->cols[colindex].width;
+		if (mx <= curx || mx >= curx + colwidth) {
+			continue;
+		}
+
+		cury = dialog->y + LINEHEIGHT + 1 + dialog->scroll;
+		for (row = 0; row < menu->cols[colindex].numrows; row++) {
+			s32 rowindex = menu->cols[colindex].rowstart + row;
+			s32 rowheight = menu->rows[rowindex].height;
+			if (my > cury && my < cury + rowheight) {
+				return &dialog->definition->items[menu->rows[rowindex].itemindex] == dialog->focuseditem;
+			}
+			cury += rowheight;
+		}
+	}
+
+	return false;
+}
 #endif
 
 #endif
