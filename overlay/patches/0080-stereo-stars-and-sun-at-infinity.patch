+/*
+ * D-097: the depth payload's largest value means INFINITY, not 32767 units.
+ * The star field (stars.c) and the sun (sky.c) are 2D rectangles PD projects
+ * itself, like a glare, but what they stand for is at infinity: the renderer
+ * gives a rectangle tagged with this the far asymptote of the world fold
+ * (the same disparity the sky dome's skew-only class has), not a depth.
+ */
+#define PD_DLTAG_DEPTH_INF    0x7fffu
 #define PD_DLTAG_SCALE_BIT    0x4000u
