 {
-	struct player *p = g_Vars.currentplayer;
+	struct player *p = playerIosLocal();
 
 	if (!p) {
 		return 0;
@@ -9522,7 +9548,7 @@
  */
 s32 playerIosGunHasSecondary(void)
 {
-	struct player *p = g_Vars.currentplayer;
+	struct player *p = playerIosLocal();
 
 	if (!p) {
 		return 0;
@@ -9538,13 +9564,26 @@
  */
 s32 playerIosGunState(s32 *function)
 {
-	struct player *p = g_Vars.currentplayer;
+	struct player *p = playerIosLocal();
 
+	s32 weaponnum = -1;
+	s32 secondary = 0;
+
+	if (p) {
+		// bgun reads the current player: make it this machine's for the read
+		const s32 prev = g_Vars.currentplayernum;
+
+		setCurrentPlayerNum(playerIosLocalNum());
+		secondary = bgunIsUsingSecondaryFunction() ? 1 : 0;
+		weaponnum = bgunGetWeaponNum(HAND_RIGHT);
+		setCurrentPlayerNum(prev);
+	}
+
 	if (function) {
-		*function = (p && bgunIsUsingSecondaryFunction()) ? 1 : 0;
+		*function = secondary;
 	}
 
-	return p ? bgunGetWeaponNum(HAND_RIGHT) : -1;
+	return weaponnum;
 }
 
 /**
@@ -9553,10 +9592,15 @@
  */
 s32 playerIosActiveMenu(s32 *slot)
 {
-	struct player *p = g_Vars.currentplayer;
+	struct player *p = playerIosLocal();
 
 	if (slot) {
