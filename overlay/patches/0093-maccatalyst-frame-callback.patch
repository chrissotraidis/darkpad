@@ -362,6 +370,16 @@
 	s32 index;
 	s32 numplayers;
 	u32 stack;
+
+#if defined(PLATFORM_IOS) && TARGET_OS_MACCATALYST
+	// The stage loop stores its persistent state in the game's globals. Its
+	// local index/numplayers values are used only during stage setup, so a
+	// resumed callback can jump straight to the frame boundary. This retains
+	// the same setup and teardown path, including online stage transitions.
+	static bool entered = false;
+	if (entered) goto mac_resume_frame;
+	entered = true;
+#endif
 
 	func0f175f98();
 
@@ -656,9 +674,19 @@
