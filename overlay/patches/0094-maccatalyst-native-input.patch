+			case SDL_CONTROLLERBUTTONDOWN:
+			case SDL_CONTROLLERAXISMOTION:
+			case SDL_TEXTINPUT:
+				return 0;
+		}
+	}
 	switch (event->type) {
 		case SDL_CONTROLLERDEVICEADDED:
 			for (s32 i = firstController; i < INPUT_MAX_CONTROLLERS; ++i) {
@@ -1437,6 +1456,11 @@
 		return -1;
 	}
 
+	if (inputShellBlocked()) {
+		memset(npad, 0, sizeof(*npad));
+		return 0;
+	}
+
 	npad->button = 0;
 
 	// Typing: the keyboard's keys are letters, not buttons. A controller
@@ -1569,6 +1593,12 @@
 	mouseX = mx;
