 #include "system.h"
 #include "fs.h"
+
+#if defined(PLATFORM_IOS) && TARGET_OS_MACCATALYST
+// Native settings must also block SDL's independent keyboard/controller path.
+extern int PDMacInputBlocked(void);
+#define inputShellBlocked() PDMacInputBlocked()
+#else
+#define inputShellBlocked() 0
+#endif
 
 #if !SDL_VERSION_ATLEAST(2, 0, 14)
